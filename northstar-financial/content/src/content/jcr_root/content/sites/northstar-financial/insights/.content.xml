<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Thinking out loud about markets, planning, and the decisions that matter."
            jcr:primaryType="nt:unstructured"
            jcr:title="Insights"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Insights."
                            headingType="h1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Thinking out loud about markets, planning, and the decisions that tend to matter most to clients."
                    />
                </container>
            </hero>
            <recent-articles
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Recent pieces"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Published March 2026. How we structure withdrawals across taxable, tax-deferred, and Roth accounts to minimize lifetime taxes."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="The Retirement Paycheck: Building Income from a Portfolio"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Published February 2026. Exchange funds, charitable remainder trusts, direct indexing, 10b5-1 plans, and plain old selling."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Concentrated Stock: Five Ways to Diversify Without a Tax Bill"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Published January 2026. A look at the historical accuracy of market forecasts and what we focus on instead."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Why We Don't Forecast the Market"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </recent-articles>
            <older-articles
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Older pieces"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Published December 2025. How spousal benefits, longevity, and tax brackets change the math."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Social Security Timing: It's Not Just About the Break-Even"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Published November 2025. Duration risk, reinvestment risk, and why we still hold bonds."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="What a Rising-Rate Environment Means for Bond Allocations"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Published October 2025. The years between retirement and Social Security are often the best window for conversions."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="The Roth Conversion Window: Timing and Tax Brackets"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </older-articles>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
