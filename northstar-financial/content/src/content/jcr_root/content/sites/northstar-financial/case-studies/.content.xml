<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Illustrative scenarios from real planning engagements."
            jcr:primaryType="nt:unstructured"
            jcr:title="Client Stories"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="A few situations, anonymized."
                            headingType="h1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Scenarios drawn from real engagements. Names and specifics have been changed to protect client privacy, but the moves are real and the numbers are close."
                    />
                </container>
            </hero>
            <studies
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Three engagements"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="A dual-income couple in their mid-fifties assumed they would work until 67. When we modelled their actual spending we found they could stop at 64 by reshaping two 401(k) withdrawals and delaying Social Security by three years. The plan saved them 28 months."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="The Martins: Retiring Three Years Earlier"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="A founder selling her services firm for $4M came to us in the middle of the M&amp;A negotiation. We coordinated with her CPA and attorney on the deal structure, ran tax projections on three exit scenarios, and built a post-sale withdrawal schedule before the wire cleared."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="A Business Owner's Exit"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="A client inherited $1.2M across a taxable brokerage, an inherited IRA, and a small trust. We consolidated the portfolio, built a ten-year RMD schedule for the inherited account, and set up a donor-advised fund to handle a year of unusually high income."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Inheriting Complexity"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </studies>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
