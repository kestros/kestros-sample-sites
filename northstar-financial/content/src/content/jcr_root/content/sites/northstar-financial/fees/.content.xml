<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Fee-only. No commissions, no hidden markups."
            jcr:primaryType="nt:unstructured"
            jcr:title="Simple, Transparent Fees"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="What we charge."
                            headingType="h1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Fee-only. No commissions, no product sales, no hidden markups. You can read the whole schedule on one page, which is the point."
                    />
                </container>
            </hero>
            <aum-tiers
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Investment management"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="1.00% per year on assets under management. Includes the ongoing financial plan and all the planning work that goes with it."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Up to $1M"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="0.75% per year on the portion above one million. Adds annual tax-projection reviews."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="$1M – $3M"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="0.50% per year on the portion above three million. Adds quarterly portfolio reviews and dedicated CPA coordination."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="$3M – $5M"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </aum-tiers>
            <planning-tiers
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Planning without assets under management"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="$5,000 to $8,000 depending on complexity. One-time engagement, 90-day delivery, a written plan at the end."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Comprehensive Plan"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="$350 per hour for specific questions or a second opinion on something you are already considering."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Project Work"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="From $4,500 per year. Quarterly check-ins and unlimited calls for clients who do not want an AUM relationship."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Annual Retainer"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </planning-tiers>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
