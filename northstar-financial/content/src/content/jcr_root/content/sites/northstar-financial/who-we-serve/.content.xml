<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="We work with people navigating real financial transitions."
            jcr:primaryType="nt:unstructured"
            jcr:title="Clients We Know Best"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Who we tend to work with."
                            headingType="h1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Most of our clients are in one of the situations below. None of them are the full story of who we can help, but they cover most of the work we do in a given year."
                    />
                </container>
            </hero>
            <segments-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Who we help"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Five to fifteen years from retirement, trying to answer &quot;do I have enough?&quot; We model multiple retirement dates and spending scenarios so the answer is specific."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Pre-Retirees (50–65)"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Succession planning, entity structure, retirement plan design, and eventual sale."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Business Owners"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Late-start savers with high income, student debt, and complex benefits. 403(b)/457 coordination, disability coverage."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Physicians &amp; Professionals"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </segments-1>
            <segments-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="And a few more"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Estate planning, gifting strategies, 529 funding, and preparing the next generation for inherited wealth."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Multi-Generational Families"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Sudden wealth from an inheritance brings tax, estate, and emotional considerations. We help you take the time to make good decisions."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Recent Inheritors"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Job change, sabbatical, early retirement. We help you evaluate the financial side of life decisions."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Career Transitioners"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </segments-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
