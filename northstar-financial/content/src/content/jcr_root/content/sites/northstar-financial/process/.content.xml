<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="A clear, collaborative path from first conversation to long-term partnership."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="How We Work Together"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="How a Northstar engagement runs."
                            headingType="h1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A working plan in about six weeks from the first conversation, then a long-term partnership that changes shape as your life does."
                    />
                </container>
            </hero>
            <steps-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="The first six weeks"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="30 minutes, no cost. We ask what brought you in today and what is keeping you up at night. You ask us anything you want, and we decide together whether it is a fit."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="First call"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="We send a short secure checklist of statements, tax returns, insurance policies, and estate documents. You upload what you have. We do the organizing from there."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Gathering the picture"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Two meetings, three weeks apart. The first covers what we found and how we are thinking about the tradeoffs. The second is the written plan and our specific recommendations."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="The written plan"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </steps-1>
            <steps-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="After the plan is done"
                            headingType="h2"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                    >
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="We run the plan with you. Opening accounts, moving assets, rebalancing portfolios, and coordinating with your CPA and attorney on anything that touches their world."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Running the plan"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="Quarterly portfolio updates, semi-annual check-ins, annual deep reviews. Plus unlimited calls when life does something you were not expecting."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="Ongoing reviews"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"
                        >
                            <card
                                    description="A new baby, a job change, an inheritance, a market panic, or a big purchase that feels too big to make alone. You already have a team that knows the whole picture."
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/card"
                            >
                                <titleElement
                                        headingText="When life happens"
                                        headingType="h3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                                />
                                <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="kestros/commons/components/content/image"
                                />
                            </card>
                        </column-3>
                    </grid>
                </container>
            </steps-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
