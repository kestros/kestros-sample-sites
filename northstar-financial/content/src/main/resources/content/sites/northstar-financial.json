{
  "jcr:primaryType": "kes:Site",
  "jcr:content": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/commons/components/kestros-base-page",
    "kes:theme": "/etc/ui-frameworks/express/versions/0.0.1/themes/default",
    "jcr:title": "Northstar Financial",
    "jcr:description": "A financial advisory services firm sample site built with the Express (Bootstrap) framework.",
    "publicationStrategy": "kestros-single-instance",
    "header": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/commons/components/inherited-content-area",
      "top-navigation": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "/libs/kestros/commons/components/navigation/top-navigation"
      }
    },
    "main": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/commons/components/content-area",
      "hero-section": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "/libs/kestros/commons/components/structure/section",
        "variations": ["bg-primary", "text-white", "py-5"],
        "container": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "/libs/kestros/commons/components/structure/container",
          "heading": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "/libs/kestros/commons/components/content/heading",
            "headingType": "h1",
            "headingText": "Your Financial Future, Clearly Mapped",
            "variations": ["display-4"]
          },
          "text": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "/libs/kestros/commons/components/content/text",
            "text": "Northstar Financial partners with individuals and families to build lasting wealth through disciplined planning and transparent advice."
          },
          "cta-buttons": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "/libs/kestros/commons/components/content/button-group",
            "button-1": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "/libs/kestros/commons/components/content/button",
              "text": "Our Services",
              "href": "/content/sites/northstar-financial/services.html",
              "variations": ["btn-light", "btn-lg"]
            },
            "button-2": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "/libs/kestros/commons/components/content/button",
              "text": "Schedule a Consultation",
              "href": "/content/sites/northstar-financial/contact.html",
              "variations": ["btn-outline-light", "btn-lg"]
            }
          }
        }
      },
      "trust-section": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "/libs/kestros/commons/components/structure/section",
        "container": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "/libs/kestros/commons/components/structure/container",
          "heading": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "/libs/kestros/commons/components/content/heading",
            "headingType": "h2",
            "headingText": "Trusted by Families Across the Region"
          },
          "grid": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "/libs/kestros/commons/components/structure/grid",
            "column-1": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "kestros/commons/components/content-area",
              "card": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/card",
                "description": "We earn fees from you, not commissions from product sales. Our interests are aligned with yours.",
                "titleElement": {
                  "jcr:primaryType": "nt:unstructured",
                  "sling:resourceType": "/libs/kestros/commons/components/content/heading",
                  "headingType": "h3",
                  "headingText": "Fee-Only Advisory"
                }
              }
            },
            "column-2": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "kestros/commons/components/content-area",
              "card": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/card",
                "description": "Investment management is just one piece. We integrate tax, estate, insurance, and retirement into a unified plan.",
                "titleElement": {
                  "jcr:primaryType": "nt:unstructured",
                  "sling:resourceType": "/libs/kestros/commons/components/content/heading",
                  "headingType": "h3",
                  "headingText": "Holistic Planning"
                }
              }
            },
            "column-3": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "kestros/commons/components/content-area",
              "card": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/card",
                "description": "Markets fluctuate. Your goals do not. We build portfolios that stay the course.",
                "titleElement": {
                  "jcr:primaryType": "nt:unstructured",
                  "sling:resourceType": "/libs/kestros/commons/components/content/heading",
                  "headingType": "h3",
                  "headingText": "Long-Term Perspective"
                }
              }
            }
          }
        }
      }
    },
    "footer": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/commons/components/inherited-content-area",
      "section": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "/libs/kestros/commons/components/structure/section",
        "variations": ["bg-dark", "text-white", "py-4"],
        "container": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "/libs/kestros/commons/components/structure/container",
          "grid": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "/libs/kestros/commons/components/structure/grid",
            "column-1": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "kestros/commons/components/content-area",
              "heading": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/heading",
                "headingType": "h5",
                "headingText": "Northstar Financial"
              },
              "text": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/text",
                "text": "Guiding your financial future with clarity and confidence."
              }
            },
            "column-2": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "kestros/commons/components/content-area",
              "heading": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/heading",
                "headingType": "h5",
                "headingText": "Legal"
              },
              "text": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/text",
                "text": "Northstar Financial is a registered investment advisory firm. Past performance does not guarantee future results."
              }
            },
            "column-3": {
              "jcr:primaryType": "nt:unstructured",
              "sling:resourceType": "kestros/commons/components/content-area",
              "heading": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/heading",
                "headingType": "h5",
                "headingText": "Contact"
              },
              "link": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "/libs/kestros/commons/components/content/link",
                "text": "info@northstarfinancial.example",
                "href": "mailto:info@northstarfinancial.example"
              }
            }
          }
        }
      }
    }
  }
}
