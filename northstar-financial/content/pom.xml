<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.kestros.cms.sample-sites</groupId>
        <artifactId>northstar-financial-site</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>io.kestros.cms.sample-sites</groupId>
    <artifactId>northstar-financial-site-content</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>Northstar Financial Site - Content</name>
    <description>Content bundle for the Northstar Financial sample site</description>
    <packaging>bundle</packaging>

    <properties>
        <bundleCategory>kestros</bundleCategory>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>0.13</version>
                <configuration>
                    <excludes>
                        <exclude>target/*</exclude>
                        <exclude>**/target/*</exclude>
                        <exclude>**/target/**/*</exclude>
                        <exclude>**/*.json</exclude>
                        <exclude>node/**/*</exclude>
                        <exclude>node_modules/**/*</exclude>
                        <exclude>**/README.md</exclude>
                        <exclude>package.json</exclude>
                        <exclude>package-lock.json</exclude>
                        <exclude>*-maven-settings.xml</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Sling-Initial-Content>
                            /content/sites/northstar-financial.json;overwrite:=true;path:=/content/sites/northstar-financial,
                            /content/sites/northstar-financial/home.json;overwrite:=true;path:=/content/sites/northstar-financial/home,
                            /content/sites/northstar-financial/services.json;overwrite:=true;path:=/content/sites/northstar-financial/services,
                            /content/sites/northstar-financial/about.json;overwrite:=true;path:=/content/sites/northstar-financial/about,
                            /content/sites/northstar-financial/insights.json;overwrite:=true;path:=/content/sites/northstar-financial/insights,
                            /content/sites/northstar-financial/contact.json;overwrite:=true;path:=/content/sites/northstar-financial/contact
                        </Sling-Initial-Content>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
