<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            jcr:primaryType="nt:unstructured"
            jcr:title="Presenters"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/style/uk-section-default]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/ui-kit-lib/3.23.6/layouts/default"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="All Presenters"
                            variations="[]"/>
                    <!-- TODO: Create a custom "presenters" datasource for the card-list component
                         that queries presenter pages and returns name, bio excerpt, headshot image,
                         and link. For now, using the child-pages datasource. -->
                    <card-list
                            jcr:primaryType="nt:unstructured"
                            cardLayout="/apps/kestros/commons/components/content/card/ui-kit-lib/3.23.6/layouts/clickable"
                            cardVariations="[/apps/kestros/commons/components/content/card/ui-kit-lib/3.23.6/variations/style/uk-card-default,/apps/kestros/commons/components/content/card/ui-kit-lib/3.23.6/variations/modifiers/uk-card-hover]"
                            kes:datasource="child-pages"
                            layout="/apps/kestros/commons/components/lists/card-list/ui-kit-lib/3.23.6/layouts/default"
                            sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                            pagesPath="/content/sites/signal-conf/presenters"
                            variations="[]"/>
                </container>
            </section>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
    <jane-chen/>
    <marcus-rivera/>
    <sarah-okonkwo/>
</jcr:root>
