<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:kes="http://kestros.io/kes/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        jcr:primaryType="kes:Page">
    <jcr:content
        jcr:description=""
        jcr:primaryType="nt:unstructured"
        jcr:title="Container"
        kes:template="/libs/kestros/commons/base-page-template"
        sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <inherited-content-area
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <inherited-content-area
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h1"
                                    text="Container"/>
                            <intro
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;A layout structure component that wraps and groups other components. Containers control the semantic HTML element type (header, main, footer, div, etc.) and can apply styling and variations.&lt;/p&gt;"/>
                            <properties-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h2"
                                    text="Properties"/>
                            <properties-text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;&lt;strong&gt;elementType&lt;/strong&gt; - The HTML element to render. Valid values: header, main, footer, section, article, aside, div, nav.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;variations&lt;/strong&gt; - Array of CSS class names applied to the container for styling.&lt;/p&gt;"/>
                            <examples-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h2"
                                    text="Examples"/>
                            <note
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;&lt;em&gt;This page itself uses a container with elementType=&quot;main&quot; to wrap the grid layout shown above.&lt;/em&gt;&lt;/p&gt;"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"/>
                    </grid>
                </container>
            </section>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
