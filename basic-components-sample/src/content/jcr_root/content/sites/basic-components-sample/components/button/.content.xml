<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:kes="http://kestros.io/kes/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        jcr:primaryType="kes:Page">
    <jcr:content
        jcr:description=""
        jcr:primaryType="nt:unstructured"
        jcr:title="Button"
        kes:template="/libs/kestros/commons/base-page-template"
        sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <inherited-content-area
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <inherited-content-area
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h1"
                                    text="Button"/>
                            <intro
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;A clickable button component that renders as a semantic anchor element. Buttons navigate to specified URLs and support customizable text, links, and optional disabled state.&lt;/p&gt;"/>
                            <properties-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h2"
                                    text="Properties"/>
                            <properties-text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;&lt;strong&gt;text&lt;/strong&gt; - The button label text (string).&lt;/p&gt;&lt;p&gt;&lt;strong&gt;link&lt;/strong&gt; - The button destination URL or page path (string).&lt;/p&gt;&lt;p&gt;&lt;strong&gt;disabled&lt;/strong&gt; - Boolean flag to disable the button. Disabled buttons render without an href.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;target&lt;/strong&gt; - Link target attribute: _self, _blank, _parent, _top. Controls whether link opens in new window.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;ariaLabel&lt;/strong&gt; - ARIA label for screen readers when visible text is insufficient.&lt;/p&gt;"/>
                            <examples-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h2"
                                    text="Examples"/>
                            <example-1
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/button"
                                    text="Click Here"
                                    link="/content/sites/basic-components-sample"/>
                            <example-2
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/button"
                                    text="External Link"
                                    link="https://kestros.io"
                                    target="_blank"/>
                            <example-3
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/button"
                                    text="Disabled Button"
                                    disabled="true"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"/>
                    </grid>
                </container>
            </section>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
