<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:kes="http://kestros.io/kes/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        jcr:primaryType="kes:Page">
    <jcr:content
        jcr:description=""
        jcr:primaryType="nt:unstructured"
        jcr:title="Heading"
        kes:template="/libs/kestros/commons/base-page-template"
        sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <inherited-content-area
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main">
                    <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="Heading"
                            headingType="h1"/>
                    <description
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Renders a configurable HTML heading element. Supports heading levels h1 through h6 with custom text content."/>
                    <resource-type
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Resource Type: content/heading"/>
                    <properties-heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="Properties"
                            headingType="h2"/>
                    <props-text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="headingText (String) - The text content displayed in the heading. Required."/>
                    <props-text-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="headingType (String) - The heading level: h1, h2, h3, h4, h5, or h6."/>
                    <examples-heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="Examples"
                            headingType="h2"/>
                    <example-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="Page Title Example"
                            headingType="h1"/>
                    <example-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="Section Heading"
                            headingType="h2"/>
                    <example-3
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="Subsection Heading"
                            headingType="h4"/>
                    <source-heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            headingText="HTL Source"
                            headingType="h2"/>
                    <source-code
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/code"
                            codeResource="/libs/kestros/commons/components/content/heading/common/content.html"/>
                </container>
            </section>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
