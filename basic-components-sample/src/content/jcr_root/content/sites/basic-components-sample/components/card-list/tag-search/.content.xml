<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:kes="http://kestros.io/kes/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="kes:Page">
    <jcr:content
        jcr:description=""
        jcr:primaryType="nt:unstructured"
        jcr:title="Card List - Tag Search"
        kes:template="/libs/kestros/commons/base-page-template"
        sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <inherited-content-area
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <inherited-content-area
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Card List Tag Search Datasource"
                                    level="h1"/>
                            <intro
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;The tag-search datasource renders a card for each child page that matches one or more configured tags. Pages are found by walking the children of a root page and checking each page's kes:tags property against the configured tag paths.&lt;/p&gt;"/>
                            <overview-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Overview"
                                    level="h2"/>
                            <overview-text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;Available on both card-list and link-list components. Select tag-search from the datasource dropdown in the component dialog.&lt;/p&gt;&lt;p&gt;Tag matching uses OR logic: a page matches if it has any of the configured tags. The current page is always excluded from results to prevent self-referencing.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Component type:&lt;/strong&gt; card-list&lt;br/&gt;&lt;strong&gt;Datasource class:&lt;/strong&gt; CardListTagSearchDataSource&lt;br/&gt;&lt;strong&gt;Behavior:&lt;/strong&gt; Finds child pages of a root page that have matching tags, renders each as a card.&lt;/p&gt;"/>
                            <config-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Configuration"
                                    level="h2"/>
                            <config-text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;&lt;strong&gt;Root Path&lt;/strong&gt; (pagesPath) - JCR path of the page whose children are searched. Defaults to parent of the containing page.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Tags&lt;/strong&gt; (tags) - One or more tag paths as a String array. Pages match if they have any of these tags.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Read More Text&lt;/strong&gt; (readMoreText) - Custom button label for each card.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Sort By&lt;/strong&gt; (sortBy) - Options: None (natural order), Title, Name, Created Date, Last Modified.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Reverse Order&lt;/strong&gt; (reverse) - Boolean checkbox. Reverses the sort direction.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Limit&lt;/strong&gt; (limit) - Number field. Maximum number of results. 0 means no limit.&lt;/p&gt;"/>
                            <tags-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="How Tags Work"
                                    level="h2"/>
                            <tags-text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;Tags are stored on pages as the kes:tags property (String array) on jcr:content. Each value is a path to a tag node under /content/tags/.&lt;/p&gt;&lt;p&gt;The datasource reads configured tags from the component content node's tags property, then iterates over child pages of the root page. For each child page, it calls TagRetrievalService.getTagsOnResource() and checks if any returned tag path matches a configured tag path.&lt;/p&gt;"/>
                            <jcr-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="JCR Structure"
                                    level="h2"/>
                            <jcr-text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;A configured card-list node in JCR has: sling:resourceType = card-list, kes:datasource = tag-search, tags = [tag paths], pagesPath = /content/sites/..., sortBy = title, reverse = false, limit = 0, readMoreText = Read More.&lt;/p&gt;"/>
                            <examples-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Examples"
                                    level="h2"/>
                            <examples-intro
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;The following examples use test pages under /content/sites/basic-components-sample/components/card-list/ with various kes:tags values. Each demonstrates a different configuration option.&lt;/p&gt;"/>
                            <ex1-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Single Tag Filter"
                                    level="h3"/>
                            <ex1-desc
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;Tag: category/arts. Sort: title.&lt;/p&gt;"/>
                            <ex1-cards
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                                    kes:dataSource="tag-search"
                                    tags="[/content/tags/basic-components-sample/category/arts]"
                                    sortBy="title"/>
                            <ex2-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Custom Button Text"
                                    level="h3"/>
                            <ex2-desc
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;Tag: category/technology. readMoreText: Learn More.&lt;/p&gt;"/>
                            <ex2-cards
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                                    kes:dataSource="tag-search"
                                    tags="[/content/tags/basic-components-sample/category/technology]"
                                    readMoreText="Learn More"
                                    sortBy="title"/>
                            <ex3-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Reverse Sort Order"
                                    level="h3"/>
                            <ex3-desc
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;Tag: content-type/article. Reverse alphabetical sort (Z-A).&lt;/p&gt;"/>
                            <ex3-cards
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                                    kes:dataSource="tag-search"
                                    tags="[/content/tags/basic-components-sample/content-type/article]"
                                    sortBy="title"
                                    reverse="{Boolean}true"/>
                            <ex4-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Result Limit"
                                    level="h3"/>
                            <ex4-desc
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;Tag: status/featured. Limit: 1.&lt;/p&gt;"/>
                            <ex4-cards
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                                    kes:dataSource="tag-search"
                                    tags="[/content/tags/basic-components-sample/status/featured]"
                                    sortBy="title"
                                    limit="{Long}1"/>
                            <ex5-heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                   
                                    text="Default Root Path"
                                    level="h3"/>
                            <ex5-desc
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                   
                                    text="&lt;p&gt;No pagesPath set. Falls back to parent page. Tag: category/science.&lt;/p&gt;"/>
                            <ex5-cards
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                                    kes:dataSource="tag-search"
                                    tags="[/content/tags/basic-components-sample/category/science]"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"/>
                    </grid>
                </container>
            </section>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
