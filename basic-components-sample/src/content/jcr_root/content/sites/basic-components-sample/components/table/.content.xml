        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <section jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/section">
                <inherited-content-area jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/inherited-content-area"/>
                <container jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container" elementType="main">
                    <title jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Table" headingType="h1"/>
                    <description jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Data table container that holds table-header and table-row children. Use for displaying structured tabular data. Table headers render as th elements, rows contain table-cell children."/>
                    <resource-type jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Resource Type: /libs/kestros/commons/components/content/table"/>
                    <properties-heading jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Properties" headingType="h2"/>
                    <props-note jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Table is a container with no direct properties. Build by adding table-header children (for column headers) and table-row children (each containing table-cell children)."/>
                    <props-header jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="table-header: text (String) - Column header text."/>
                    <props-cell jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="table-cell: Container — add any content component as a child."/>
                    <examples-heading jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Examples" headingType="h2"/>
                    <example-1 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/table">
