<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:kes="http://kestros.io/kes/1.0" xmlns:mix="http://www.jcp.org/jcr/mix/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Site">
    <jcr:content
            jcr:description="A sample site to demonstrate the basic components of Kestros."
            jcr:primaryType="nt:unstructured"
            jcr:title="Basic Components Sample"
            kes:theme="/etc/ui-frameworks/ui-kit/versions/0.0.1/themes/default"
            sling:resourceType="kestros/commons/components/kestros-base-page"
            displayDescription=""
            publicationStrategy="kestros-single-instance">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area">
            <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/container"
                    elementType="header">
                <section
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/section">
                    <page-title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/page-title"
                            level="h1"/>
                </section>
                <section-1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/section">
                    <navigation
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/navigation"/>
                </section-1>
            </container>
        </header>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <inherited-content-area
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/inherited-content-area">
                    <breadcrumbs
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/breadcrumbs"/>
                </inherited-content-area>
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Components"/>
                            <richtext
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;h4&gt;Structure&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/accordion&quot;&gt;Accordion&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/accordion-panel&quot;&gt;Accordion Panel&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/container&quot;&gt;Container&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/grid&quot;&gt;Grid&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/section&quot;&gt;Section&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4&gt;Content&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/alert&quot;&gt;Alert&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/button&quot;&gt;Button&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/button-group&quot;&gt;Button Group&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/code&quot;&gt;Code&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/heading&quot;&gt;Heading&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/image&quot;&gt;Image&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/link&quot;&gt;Link&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/richtext&quot;&gt;Richtext&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/text&quot;&gt;Text&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/video&quot;&gt;Video&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/video-embed&quot;&gt;Video Embed&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4&gt;Lists&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card&quot;&gt;Card&lt;/a&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card/asset-card&quot;&gt;Asset Card&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card/page-card&quot;&gt;Page Card&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card-list&quot;&gt;Card List&lt;/a&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card-list/asset-list&quot;&gt;Asset List&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card-list/child-pages&quot;&gt;Child Pages&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/card-list/tag-search&quot;&gt;Tag Search&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/link-list&quot;&gt;Link List&lt;/a&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/link-list/child-pages&quot;&gt;Child Pages&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/link-list/tag-search&quot;&gt;Tag Search&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4&gt;Navigation&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/breadcrumb&quot;&gt;Breadcrumb&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/breadcrumbs&quot;&gt;Breadcrumbs&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/navigation&quot;&gt;Navigation&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/navigation-item&quot;&gt;Navigation Item&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/top-navigation&quot;&gt;Top Navigation&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/top-navigation-item&quot;&gt;Top Navigation Item&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4&gt;Utilities&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/dialog-field-sample&quot;&gt;Dialog Field Sample&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/page-title&quot;&gt;Page Title&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;/content/sites/basic-components-sample/components/table&quot;&gt;Table&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;"/>
                        </column-1>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"/>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                        </column-2>
                    </grid>
                </container>
            </section>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area">
            <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/container"
                    elementType="footer">
                <section
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/section">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Links"/>
                            <button
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/button"
                                    href="https://kestros.io"
                                    label="Kestros IO"
                                    link="https://kestros.io"
                                    text="Kestros IO"/>
                            <button-1
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/button"
                                    href="https://github.com/kestros"
                                    label="Github"
                                    link="https://github.com/kestros"
                                    text="Github"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Documentation"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area"/>
                    </grid>
                </section>
            </container>
        </footer>
    </jcr:content>
    <components/>
</jcr:root>
