<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Static/Default"
        group="Sample Components"
        classPath="io.kestros.samples.content.dialogfieldsample.DialogFieldSampleStaticDataSource">
    <edit
            jcr:primaryType="nt:unstructured"
            sling:resourceType="kestros/cms2/dialog">
        <content
                jcr:primaryType="nt:unstructured">
            <sampleText
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/textfield"
                    label="Text Field"
                    name="sampleText"/>
            <sampleTextarea
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/textarea"
                    label="Textarea"
                    name="sampleTextarea"/>
            <sampleRichtext
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/richtext"
                    label="Rich Text"
                    name="sampleRichtext"/>
            <sampleCheckbox
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/checkbox"
                    label="Checkbox"
                    name="sampleCheckbox"/>
            <samplePath
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/pathfield"
                    label="Path Field"
                    name="samplePath"/>
            <sampleSelect
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/selectfield"
                    label="Select Field"
                    name="sampleSelect">
                <options jcr:primaryType="nt:unstructured">
                    <option1
                            jcr:primaryType="nt:unstructured"
                            text="Option A"
                            value="optionA"
                            selected="{Boolean}true"/>
                    <option2
                            jcr:primaryType="nt:unstructured"
                            text="Option B"
                            value="optionB"
                            selected="{Boolean}false"/>
                    <option3
                            jcr:primaryType="nt:unstructured"
                            text="Option C"
                            value="optionC"
                            selected="{Boolean}false"/>
                </options>
            </sampleSelect>
            <sampleMultifield
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/multifield"
                    label="Multifield"
                    name="sampleMultifield">
                <field
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="kestros/cms2/fields/general/textfield"
                        label="Item"
                        name="item"/>
            </sampleMultifield>
            <sampleTag
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/tagfield"
                    label="Tag Field"
                    name="sampleTag"/>
            <sampleNumber
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/numberfield"
                    label="Number Field"
                    name="sampleNumber"/>
            <sampleDate
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/datefield"
                    label="Date Field"
                    name="sampleDate"/>
            <sampleDatetime
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/datetimefield"
                    label="DateTime Field"
                    name="sampleDatetime"/>
            <sampleToggle
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/togglefield"
                    label="Toggle Field"
                    name="sampleToggle"/>
            <sampleRadio
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/radiogroup"
                    label="Radio Group"
                    name="sampleRadio">
                <options jcr:primaryType="nt:unstructured">
                    <radio1
                            jcr:primaryType="nt:unstructured"
                            text="Radio Option 1"
                            value="radio1"
                            selected="{Boolean}true"/>
                    <radio2
                            jcr:primaryType="nt:unstructured"
                            text="Radio Option 2"
                            value="radio2"
                            selected="{Boolean}false"/>
                </options>
            </sampleRadio>
            <sampleHidden
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/hiddenfield"
                    label="Hidden Field"
                    name="sampleHidden"/>
            <sampleImage
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="kestros/cms2/fields/general/imageassetpicker"
                    label="Image/Asset Picker"
                    name="sampleImage"/>
        </content>
    </edit>
</jcr:root>
