n" variations="[row]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><col layout="plain" variations="[col-lg-8,mx-auto]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><hero imagePath="/content/sites/acpl-p4-bootstrap-versions/assets/story-1.jpg" altText="Harborside United dismantle Northgate Rovers in Matchweek 14" variations="[img-fluid,rounded,mb-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/image"/><lead variations="[lead,mb-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Oliver Reid struck first and never looked back as Northgate Rovers fell 0-4 at Harborside Coliseum."/><p0 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Harborside United claimed a 4-0 win over Northgate Rovers in front of 23,113 at Harborside Coliseum, a result that keeps the Matchweek 14 talking points coming."/><p1 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="The goals came from Oliver Reid (27&#39;), Mateo Reyes (27&#39;), Patrice Ndiaye (58&#39;) and Mateo Reyes (71&#39;)."/><p2 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="The hosts saw 61% of the ball, registering 14 shots to the visitors&#39; 7, and referee D. Whitlock kept the game flowing (14°C, clear)."/><p3 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Harborside United will feel the scoreline was a fair reflection of the contest, while Northgate Rovers head home knowing the margins at this level remain unforgiving."/><p4 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Attention now turns to the next round of fixtures, with both camps expected to rotate as the schedule tightens."/><back href="/content/sites/acpl-p4-bootstrap-versions/stories.html" variations="[btn,btn-outline-primary,btn-sm,mt-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="← Back to all stories"/><mc href="/content/sites/acpl-p4-bootstrap-versions/matches/1343.html" variations="[btn,btn-primary,btn-sm,mt-3,ms-2]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Match centre →"/></col></row></wrap><related layout="plain" variations="[container,my-5,pt-4,border-top]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><rh variations="[section-heading,mb-4]" headingText="Related Stories" headingType="h2" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><rl layout="default" kes:datasource="related-stories" story="mw14-harborside-northgate" limit="3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/></related></main>
