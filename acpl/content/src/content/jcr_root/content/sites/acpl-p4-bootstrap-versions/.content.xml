<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Site">
    <jcr:content
            jcr:description="Atlantic Coast Premier League — bootstrap-classic sample site."
            jcr:primaryType="nt:unstructured"
            jcr:title="ACPL — P4 Bootstrap version walk"
            kes:template="/libs/kestros/commons/base-site-template"
            kes:theme="/etc/ui-frameworks/acpl-framework/versions/0.1.3/themes/default"
            publicationStrategy="kestros-single-instance"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area">
            <top-navigation brandHref="/content/sites/acpl-p4-bootstrap-versions.html" brandName="ACPL"
                    variations="[navbar-dark,bg-dark,sticky-top]"
                    jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation">
                <nav-home href="/content/sites/acpl-p4-bootstrap-versions.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Home"/>
                <nav-results href="/content/sites/acpl-p4-bootstrap-versions/results.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Results"/>
                <nav-stories href="/content/sites/acpl-p4-bootstrap-versions/stories.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Stories"/>
                <nav-schedule href="/content/sites/acpl-p4-bootstrap-versions/schedule.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Schedule"/>
                <nav-standings href="/content/sites/acpl-p4-bootstrap-versions/standings.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Standings"/>
                <nav-teams href="/content/sites/acpl-p4-bootstrap-versions/teams.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Clubs"/>
            </top-navigation>
        </header>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">

            <hero jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                <hero-heading headingText="Matchweek 18" headingType="h1" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                <featured kes:datasource="hero-story" limit="1" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/>
            </hero>

            <dashboard jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                <dashboard-heading headingText="Around the League" headingType="h2" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                <grid layout="33-33-33" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/grid">

                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h headingText="Upcoming Fixtures" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                        <matches kes:datasource="fixtures" mode="fixtures" limit="6" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/>
                        <all href="/content/sites/acpl-p4-bootstrap-versions/schedule.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Full schedule"/>
                    </column-1>

                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h headingText="Top of the Table" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                        <table variations="[table,table-sm]" kes:datasource="standings" limit="5" columns="pos,club,p,pts" headers="#,Club,P,Pts" clubDisplay="name" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/table"/>
                        <all href="/content/sites/acpl-p4-bootstrap-versions/standings.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Full standings"/>
                    </column-2>

                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h headingText="Recent Results" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                        <matches kes:datasource="results" mode="results" limit="6" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/>
                        <all href="/content/sites/acpl-p4-bootstrap-versions/results.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Matchweek 17 results"/>
                    </column-3>

                </grid>
            </dashboard>

            <stories jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                <stories-heading headingText="Latest Stories" headingType="h2" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                <latest kes:datasource="stories" limit="3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/>
                <allstories href="/content/sites/acpl-p4-bootstrap-versions/stories.html" variations="[btn-primary]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/button" text="All stories"/>
            </stories>

        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area">
            <wrap variations="[py-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                <grid layout="33-33-33" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h headingText="Atlantic Coast Premier League" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="© 2026 Atlantic Coast Premier League"/>
                        <t2 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Where the coast comes to play."/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h headingText="Quick Links" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                        <l0 href="/content/sites/acpl-p4-bootstrap-versions/results.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Results"/>
                        <l1 href="/content/sites/acpl-p4-bootstrap-versions/standings.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Standings"/>
                        <l2 href="/content/sites/acpl-p4-bootstrap-versions/stories.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Stories"/>
                        <l3 href="/content/sites/acpl-p4-bootstrap-versions/schedule.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Schedule"/>
                        <l4 href="/content/sites/acpl-p4-bootstrap-versions/teams.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Clubs"/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h headingText="Official Partners" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/>
                        <p1 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="CoastSport Media · Atlantic Bank · Tidal Energy"/>
                        <p2 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Harbour Breweries · SkyBet"/>
                    </column-3>
                </grid>
            </wrap>
        </footer>
        <dynamic-routes jcr:primaryType="kes:DynamicRoutes">
            <team-route jcr:primaryType="kes:DynamicRoute" pattern="teams/{slug}" targetPage="team" parameters="[team:slug]"/>
        </dynamic-routes>
    </jcr:content>
</jcr:root>
