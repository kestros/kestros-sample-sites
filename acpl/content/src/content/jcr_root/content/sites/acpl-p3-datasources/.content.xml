<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Site">
    <jcr:content
            jcr:description="Atlantic Coast Premier League — bootstrap-classic sample site."
            jcr:primaryType="nt:unstructured"
            jcr:title="ACPL — P3 Bootstrap + datasources"
            kes:template="/libs/kestros/commons/base-site-template"
            kes:theme="/etc/ui-frameworks/acpl-framework/versions/0.0.2/themes/default"
            publicationStrategy="kestros-single-instance"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area">
            <top-navigation brandHref="/content/sites/acpl-p3-datasources.html" brandName="ACPL"
                    variations="[acpl-navbar,navbar-dark,sticky-top]"
                    jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation">
                <nav-home href="/content/sites/acpl-p3-datasources.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Home"/>
                <nav-results href="/content/sites/acpl-p3-datasources/results.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Results"/>
                <nav-stories href="/content/sites/acpl-p3-datasources/stories.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Stories"/>
                <nav-schedule href="/content/sites/acpl-p3-datasources/schedule.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Schedule"/>
                <nav-standings href="/content/sites/acpl-p3-datasources/standings.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Standings"/>
                <nav-teams href="/content/sites/acpl-p3-datasources/teams.html" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item" text="Clubs"/>
            </top-navigation>
        </header>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area"><titlestrip layout="plain" variations="[acpl-title-strip]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="ATLANTIC COAST PREMIER LEAGUE — MATCHWEEK 18 — THU 19 FEB"/></titlestrip>
            <hero layout="match-list" kes:datasource="hero-story" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/>
            <dashboard variations="[my-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                <row layout="plain" variations="[row,g-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                    <col-fixtures layout="plain" variations="[col-md-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><card layout="plain" variations="[card,border-0,shadow-sm,h-100]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><chead layout="plain" variations="[card-header,acpl-card-header,d-flex,justify-content-between,align-items-center]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Upcoming Fixtures"/></chead><cbody layout="plain" variations="[card-body,p-0]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><matches layout="match-list" kes:datasource="fixtures" mode="fixtures" limit="6" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/></cbody><cfoot layout="plain" variations="[card-footer,bg-transparent,text-center]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><l href="/content/sites/acpl-p3-datasources/schedule.html" variations="[text-muted,small,text-decoration-none]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Matchweek 18 →"/></cfoot></card></col-fixtures>
                    <col-standings layout="plain" variations="[col-md-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><card layout="plain" variations="[card,border-0,shadow-sm,h-100]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><chead layout="plain" variations="[card-header,acpl-card-header,d-flex,justify-content-between,align-items-center]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Top of the Table"/></chead><cbody layout="plain" variations="[card-body,p-0]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><table variations="[table-sm,table-borderless,align-middle,mb-0,standings-widget]" kes:datasource="standings" limit="5" columns="pos,club,p,pts" headers="#,Club,P,Pts" clubDisplay="rich-name" clubCellLayout="club" clubCellVariations="[d-flex,align-items-center,gap-2]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/table"/></cbody><cfoot layout="plain" variations="[card-footer,bg-transparent,text-center]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><l href="/content/sites/acpl-p3-datasources/standings.html" variations="[text-muted,small,text-decoration-none]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="View full standings →"/></cfoot></card></col-standings>
                    <col-results layout="plain" variations="[col-md-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                        <card layout="plain" variations="[card,border-0,shadow-sm,h-100]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                            <chead layout="plain" variations="[card-header,acpl-card-header,d-flex,justify-content-between,align-items-center]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                                <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Recent Results"/>
                            </chead>
                            <cbody layout="plain" variations="[card-body,p-0]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><matches layout="match-list" kes:datasource="results" mode="results" limit="6" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/></cbody>
                            <cfoot layout="plain" variations="[card-footer,bg-transparent,text-center]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container">
                                <l href="/content/sites/acpl-p3-datasources/results.html" variations="[text-muted,small,text-decoration-none]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Matchweek 17 results →"/>
                            </cfoot>
                        </card>
                    </col-results>
                </row>
            </dashboard>
            <footer-cta variations="[mb-5]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><heading headingText="Latest Stories" headingType="h2" variations="[section-heading,mb-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><stories layout="plain" kes:datasource="stories" limit="3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/><allstories layout="plain" variations="[text-center,mt-2]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><b href="/content/sites/acpl-p3-datasources/stories.html" variations="[btn-outline-primary,btn-sm]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/button" text="All stories →"/></allstories></footer-cta>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"><wrap layout="plain" variations="[acpl-footer,py-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><inner variations="[]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><row layout="plain" variations="[row]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><c1 layout="plain" variations="[col-md-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><h variations="[footer-heading]" headingText="Atlantic Coast Premier League" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><t variations="[mb-1]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="© 2026 Atlantic Coast Premier League"/><t2 variations="[mb-0,opacity-50]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Where the coast comes to play."/></c1><c2 layout="plain" variations="[col-md-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><h variations="[footer-heading]" headingText="Quick Links" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><l0 href="/content/sites/acpl-p3-datasources/results.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Results"/><l1 href="/content/sites/acpl-p3-datasources/standings.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Standings"/><l2 href="/content/sites/acpl-p3-datasources/stories.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Stories"/><l3 href="/content/sites/acpl-p3-datasources/schedule.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Schedule"/><l4 href="/content/sites/acpl-p3-datasources/teams.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Clubs"/><l5 href="/content/sites/acpl-p3-datasources/matches.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Matches"/><l6 href="/content/sites/acpl-p3-datasources/players.html" variations="[d-block]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Players"/></c2><c3 layout="plain" variations="[col-md-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><h variations="[footer-heading]" headingText="Official Partners" headingType="h3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><p1 variations="[opacity-50,mb-1]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="CoastSport Media · Atlantic Bank · Tidal Energy"/><p2 variations="[opacity-50]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Harbour Breweries · SkyBet"/></c3></row></inner></wrap></footer>
        <dynamic-routes jcr:primaryType="kes:DynamicRoutes">
            <team-route jcr:primaryType="kes:DynamicRoute" pattern="teams/{slug}" targetPage="team" parameters="[team:slug]"/>
        </dynamic-routes>
    </jcr:content>
</jcr:root>
