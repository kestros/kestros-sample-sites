        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area"><band layout="plain" variations="[bg-primary,text-white,py-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><inner layout="plain" variations="[container]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><crumb layout="plain" variations="[d-flex,gap-2,mb-2,small]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><hl href="/content/sites/acpl-p3-datasources.html" variations="[text-white-50,text-decoration-none]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Home"/><sep variations="[text-white-50]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="/"/><sl href="/content/sites/acpl-p3-datasources/stories.html" variations="[text-white-50,text-decoration-none]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Stories"/></crumb><cat variations="[text-white-50,small,text-uppercase,fw-bold,mb-1]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Feature"/><h variations="[h3,fw-bold,mb-2]" headingText="Harborside United stretch clear at the summit" headingType="h1" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><by variations="[text-white-50,mb-0]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Priya Nair · 8 February 2026"/></inner></band><wrap layout="plain" variations="[container,my-5]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><row layout="plain" variations="[row]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><col layout="plain" variations="[col-lg-8,mx-auto]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><hero imagePath="/content/sites/acpl-p3-datasources/assets/story-1.jpg" altText="Harborside United stretch clear at the summit" variations="[img-fluid,rounded,mb-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/image"/><lead variations="[lead,mb-4]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Harborside United lead the way on 42 points, but Saint Mary&#39;s FC and Westmoreland Athletic are refusing to let the title race settle."/><p0 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="With the business end of the season in view, Harborside United sit top of the Atlantic Coast Premier League on 42 points from 17 games — a record of 13 wins, 3 draws and just 1 defeat."/><p1 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Behind them, Saint Mary&#39;s FC (34 pts) and Westmoreland Athletic (32 pts) are refusing to blink, while Harborside United&#39;s goal difference of +36 is the division&#39;s best by some distance."/><p2 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="The chasing pair meet each other once more before the season is out, meaning the leaders may only need to hold serve at home to keep the destiny of the title in their own hands."/><p3 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="History urges caution: leads have evaporated at this stage before, and the fixture computer has saved several of the leaders&#39; hardest away days for the run-in."/><p4 variations="[mb-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="What is beyond argument is that the front three have separated themselves from the pack — fourth place is already 2 points off the podium."/><back href="/content/sites/acpl-p3-datasources/stories.html" variations="[btn,btn-outline-primary,btn-sm,mt-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="← Back to all stories"/></col></row></wrap><related layout="plain" variations="[container,my-5,pt-4,border-top]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><rh variations="[section-heading,mb-4]" headingText="Related Stories" headingType="h2" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><rl layout="default" kes:datasource="related-stories" story="feature-title-race" limit="3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/></related></main>
