nents/content/text" text="Attention now turns to the next round of fixtures, with both camps expected to rotate as the schedule tightens."/><back href="/content/sites/acpl-p3-datasources/stories.html" variations="[btn,btn-outline-primary,btn-sm,mt-3]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="← Back to all stories"/><mc href="/content/sites/acpl-p3-datasources/matches/1362.html" variations="[btn,btn-primary,btn-sm,mt-3,ms-2]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Match centre →"/></col></row></wrap><related layout="plain" variations="[container,my-5,pt-4,border-top]" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/structure/container"><rh variations="[section-heading,mb-4]" headingText="Related Stories" headingType="h2" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading"/><rl layout="default" kes:datasource="related-stories" story="mw17-westmoreland-highland" limit="3" jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/lists/card-list"/></related></main>
