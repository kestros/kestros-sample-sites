<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            jcr:primaryType="nt:unstructured"
            jcr:title="Studio"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <!-- Studio Story Section -->
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/style/uk-section-default,/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/size/uk-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/ui-kit-lib/3.23.6/layouts/default"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Our Studio"
                            layout="/apps/kestros/commons/components/content/heading/ui-kit-lib/3.23.6/layouts/line-left"
                            variations="[/apps/kestros/commons/components/content/heading/ui-kit-lib/3.23.6/variations/text-transform/uk-text-uppercase,/apps/kestros/commons/components/content/heading/ui-kit-lib/3.23.6/variations/font-size/uk-heading-medium]"/>
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            layout="/apps/kestros/commons/components/structure/grid/ui-kit-lib/3.23.6/layouts/50-50"
                            variations="[/apps/kestros/commons/components/structure/grid/ui-kit-lib/3.23.6/variations/gap-modifiers/uk-grid-large]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/image"
                                    altText="Haven Architecture studio interior"
                                    imagePath="TODO: Architecture studio workspace - open loft with exposed brick, large shared worktables, architectural models on shelves, natural light from skylights"
                                    variations="[]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <richtext
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.&lt;/p&gt;&lt;p&gt;Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.&lt;/p&gt;&lt;p&gt;Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam.&lt;/p&gt;"
                                    variations="[]"/>
                        </column-2>
                    </grid>
                </container>
            </section>
            <!-- Leadership Bios -->
            <section-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/style/uk-section-muted,/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/size/uk-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/ui-kit-lib/3.23.6/layouts/default"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Leadership"
                            layout="/apps/kestros/commons/components/content/heading/ui-kit-lib/3.23.6/layouts/line-left"
                            variations="[/apps/kestros/commons/components/content/heading/ui-kit-lib/3.23.6/variations/text-transform/uk-text-uppercase]"/>
                    <!-- TODO: Create a custom "leadership-bios" datasource for the card-list component
                         that queries team member pages under /content/sites/haven-architecture/studio
                         and returns name, title, headshot, and bio excerpt for each.
                         For now, using the child-pages datasource. -->
                    <card-list
                            jcr:primaryType="nt:unstructured"
                            kes:datasource="child-pages"
                            sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                            pagesPath="/content/sites/haven-architecture/studio"
                            layout="/apps/kestros/commons/components/lists/card-list/ui-kit-lib/3.23.6/layouts/default"
                            cardLayout="/apps/kestros/commons/components/content/card/ui-kit-lib/3.23.6/layouts/default"
                            cardVariations="[/apps/kestros/commons/components/content/card/ui-kit-lib/3.23.6/variations/style/uk-card-default]"
                            variations="[/apps/kestros/commons/components/lists/card-list/ui-kit-lib/3.23.6/variations/modifiers/uk-grid-match]"/>
                </container>
            </section-1>
            <!-- Studio Values -->
            <section-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/style/uk-section-default,/apps/kestros/commons/components/structure/section/ui-kit-lib/3.23.6/variations/size/uk-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/ui-kit-lib/3.23.6/layouts/default"
                        variations="[/apps/kestros/commons/components/structure/container/ui-kit-lib/3.23.6/variations/size/uk-container-small]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Our Values"
                            variations="[/apps/kestros/commons/components/content/heading/ui-kit-lib/3.23.6/variations/text-transform/uk-text-uppercase]"/>
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            layout="/apps/kestros/commons/components/structure/grid/ui-kit-lib/3.23.6/layouts/default"
                            variations="[/apps/kestros/commons/components/structure/grid/ui-kit-lib/3.23.6/variations/gap-modifiers/uk-grid-large]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Context"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt."
                                    variations="[/apps/kestros/commons/components/content/text/ui-kit-lib/3.23.6/variations/text-color/uk-text-muted]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Craft"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip."
                                    variations="[/apps/kestros/commons/components/content/text/ui-kit-lib/3.23.6/variations/text-color/uk-text-muted]"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Sustainability"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore."
                                    variations="[/apps/kestros/commons/components/content/text/ui-kit-lib/3.23.6/variations/text-color/uk-text-muted]"/>
                        </column-3>
                    </grid>
                </container>
            </section-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
    <elena-vargas/>
    <james-mori/>
    <sara-lindqvist/>
</jcr:root>
