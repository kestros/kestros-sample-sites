<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Founded 2003. Eleven people in a converted warehouse. Five or six projects a year."
            jcr:primaryType="nt:unstructured"
            jcr:title="Our Studio"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Studio"
                    />
                    <heading
                            headingText="Eleven people in a warehouse."
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Founded 2003. Based in the inner city. Five or six projects a year, no more than we can do well."
                    />
                </container>
            </hero>
            <how-we-work
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="How we work."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="We believe architecture is a slow discipline. The work we are proudest of took a long time to design and longer to build. We try to protect that pace and not to apologize for it."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Every project begins with a long walk around the site, a conversation with whoever will use the building, and about four weeks of hand drawing before we turn on a computer. The sketches are slow enough to think with, which is the point."
                    />
                    <p3
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="We keep the studio at eleven people on purpose. Small is a commitment, not a stage we are passing through. At eleven we can sit together at lunch, and the principal is involved in every project from the first sketch to the day it opens."
                    />
                </container>
            </how-we-work>
            <history
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="A short history."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <history-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text=" &lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;   &lt;dt&gt;2003&lt;/dt&gt;   &lt;dd&gt;M. Haven and J. Ortega found the studio in a small back room above a bookshop. First project is a backyard studio for a printmaker.&lt;/dd&gt;   &lt;dt&gt;2008&lt;/dt&gt;   &lt;dd&gt;Studio moves into the current warehouse space. First civic project, a library renovation, wraps up the following spring.&lt;/dd&gt;   &lt;dt&gt;2012&lt;/dt&gt;   &lt;dd&gt;Adds a second principal, R. Kline, to head up the cultural work. The Ashford Cultural Centre competition is won three years later.&lt;/dd&gt;   &lt;dt&gt;2019&lt;/dt&gt;   &lt;dd&gt;Blackrock Studio opens. First project we would describe as adaptive reuse in any honest sense of the word.&lt;/dd&gt;   &lt;dt&gt;2023&lt;/dt&gt;   &lt;dd&gt;Meridian House completes. Eleven-person studio, about forty projects under the belt, still drawing the first four weeks by hand.&lt;/dd&gt; &lt;/dl&gt;"
                    />
                </container>
            </history>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
