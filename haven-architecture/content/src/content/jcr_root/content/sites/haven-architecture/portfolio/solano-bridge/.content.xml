    <jcr:content
            jcr:description="Solano Bridge. Pedestrian bridge. River crossing, Solano district. 2024."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="Solano Bridge"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <meta
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Pedestrian bridge. River crossing, Solano district. 2024. In construction."
                    />
                    <heading
                            headingText="Solano Bridge"
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A pedestrian bridge replacing the temporary one that has been up for seventeen years."
                    />
                    <hero-image
                            altText="Solano Bridge"
                            imagePath="https://images.unsplash.com/photo-1467632499275-7a693a761056?w=1800&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                    />
                </container>
            </hero>
            <story
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <p0
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Solano is a weathering-steel pedestrian bridge replacing a temporary wooden span that the city put up in 2007 as a quick fix and then forgot about. The brief was &quot;something nicer than what is there now and something that will last forty years&quot;, which is a fine brief if you read it charitably."
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The structure is a single span, 34 metres, in a shallow truss with the handrails integrated into the top chord. The deck is larch planks, grooved, replaceable in sections. The whole thing sits on two small concrete abutments set back from the water's edge so the ecology of the bank does not get disturbed."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Construction starts in early 2026 and should finish by the end of summer. We will post progress photos when we remember to."
                    />
                </container>
            </story>
            <facts
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Project facts"
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <facts-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;
  &lt;dt&gt;Span&lt;/dt&gt;
  &lt;dd&gt;34 metres&lt;/dd&gt;
  &lt;dt&gt;Material&lt;/dt&gt;
  &lt;dd&gt;Weathering steel, larch deck&lt;/dd&gt;
  &lt;dt&gt;Replaces&lt;/dt&gt;
  &lt;dd&gt;Temporary bridge, 2007&lt;/dd&gt;
  &lt;dt&gt;Budget&lt;/dt&gt;
  &lt;dd&gt;$1.2M&lt;/dd&gt;
  &lt;dt&gt;Expected completion&lt;/dt&gt;
  &lt;dd&gt;Summer 2026&lt;/dd&gt;
&lt;/dl&gt;"
                    />
                </container>
            </facts>
