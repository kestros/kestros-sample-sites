<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Meridian House. Private residence. Northern coastline. 2023."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="Meridian House"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <meta
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Private residence. Northern coastline. 2023. Completed."
                    />
                    <heading
                            headingText="Meridian House"
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A house built to watch the horizon rather than compete with it."
                    />
                    <hero-image
                            altText="Meridian House"
                            imagePath="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1800&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                    />
                </container>
            </hero>
            <story
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <p0
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Meridian House sits on a rocky headland facing due north, with the water on three sides and the wind for company. The program is simple: a single-family home for a couple who had retired from the city and wanted to see weather coming."
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The plan is a long bar turned parallel to the coast, broken into three volumes connected by glazed passages. The middle volume holds the kitchen and the shared living space. The end volumes are bedrooms and a small studio. Every room faces the water."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The structure is reclaimed timber over a cast concrete base. The roof pitches inland, catching runoff into a cistern that feeds the garden. The garden is indigenous grasses, unirrigated, because the client wanted to see what the land would do on its own."
                    />
                </container>
            </story>
            <facts
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Project facts"
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <facts-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;
  &lt;dt&gt;Size&lt;/dt&gt;
  &lt;dd&gt;320 m2&lt;/dd&gt;
  &lt;dt&gt;Site&lt;/dt&gt;
  &lt;dd&gt;1.4 hectares&lt;/dd&gt;
  &lt;dt&gt;Materials&lt;/dt&gt;
  &lt;dd&gt;Reclaimed cedar, board-formed concrete, zinc roof&lt;/dd&gt;
  &lt;dt&gt;Collaborators&lt;/dt&gt;
  &lt;dd&gt;Pine &amp; Drake structural, L. Ferris landscape&lt;/dd&gt;
  &lt;dt&gt;Completion&lt;/dt&gt;
  &lt;dd&gt;October 2023&lt;/dd&gt;
&lt;/dl&gt;"
                    />
                </container>
            </facts>
            <more-work
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="More work"
                    />
                    <heading
                            headingText="Related projects."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <others
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;div class=&quot;uk-grid uk-child-width-1-3@m&quot; uk-grid&gt;

  &lt;div&gt;
    &lt;a href=&quot;/content/sites/haven-architecture/portfolio/ashford-cultural-centre.html&quot; class=&quot;uk-link-reset&quot;&gt;
      &lt;img src=&quot;https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=1800&amp;q=80&quot; alt=&quot;Ashford Cultural Centre&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;
      &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Cultural institution. 2022&lt;/p&gt;
      &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Ashford Cultural Centre&lt;/h4&gt;
    &lt;/a&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;a href=&quot;/content/sites/haven-architecture/portfolio/linden-residence.html&quot; class=&quot;uk-link-reset&quot;&gt;
      &lt;img src=&quot;https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=1800&amp;q=80&quot; alt=&quot;Linden Residence&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;
      &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Private residence. 2021&lt;/p&gt;
      &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Linden Residence&lt;/h4&gt;
    &lt;/a&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;a href=&quot;/content/sites/haven-architecture/portfolio/crestwood-pavilion.html&quot; class=&quot;uk-link-reset&quot;&gt;
      &lt;img src=&quot;https://images.unsplash.com/photo-1448630360428-65456885c650?w=1800&amp;q=80&quot; alt=&quot;Crestwood Pavilion&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;
      &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Public pavilion. 2020&lt;/p&gt;
      &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Crestwood Pavilion&lt;/h4&gt;
    &lt;/a&gt;
  &lt;/div&gt;
&lt;/div&gt;"
                    />
                </container>
            </more-work>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
