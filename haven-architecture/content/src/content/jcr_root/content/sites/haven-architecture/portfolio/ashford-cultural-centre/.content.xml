                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="More work"
                    />
                    <heading
                            headingText="Related projects."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <others
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;div class=&quot;uk-grid uk-child-width-1-3@m&quot; uk-grid&gt;

  &lt;div&gt;
    &lt;a href=&quot;/content/sites/haven-architecture/portfolio/meridian-house.html&quot; class=&quot;uk-link-reset&quot;&gt;
      &lt;img src=&quot;https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1800&amp;q=80&quot; alt=&quot;Meridian House&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;
      &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Private residence. 2023&lt;/p&gt;
      &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Meridian House&lt;/h4&gt;
    &lt;/a&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;a href=&quot;/content/sites/haven-architecture/portfolio/linden-residence.html&quot; class=&quot;uk-link-reset&quot;&gt;
      &lt;img src=&quot;https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=1800&amp;q=80&quot; alt=&quot;Linden Residence&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;
      &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Private residence. 2021&lt;/p&gt;
      &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Linden Residence&lt;/h4&gt;
    &lt;/a&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;a href=&quot;/content/sites/haven-architecture/portfolio/crestwood-pavilion.html&quot; class=&quot;uk-link-reset&quot;&gt;
      &lt;img src=&quot;https://images.unsplash.com/photo-1448630360428-65456885c650?w=1800&amp;q=80&quot; alt=&quot;Crestwood Pavilion&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;
      &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Public pavilion. 2020&lt;/p&gt;
      &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Crestwood Pavilion&lt;/h4&gt;
    &lt;/a&gt;
  &lt;/div&gt;
&lt;/div&gt;"
                    />
                </container>
            </more-work>
        </main>
