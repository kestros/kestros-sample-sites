    <jcr:content
            jcr:description="Ashford Cultural Centre. Cultural institution. Town square, Ashford. 2022."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="Ashford Cultural Centre"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <meta
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Cultural institution. Town square, Ashford. 2022. Completed."
                    />
                    <heading
                            headingText="Ashford Cultural Centre"
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A civic building that uses its courtyard harder than its rooms."
                    />
                    <hero-image
                            altText="Ashford Cultural Centre"
                            imagePath="https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=1800&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                    />
                </container>
            </hero>
            <story
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <p0
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The brief for Ashford was a modest civic building with a gallery, a 180-seat auditorium, and a cafe. What the town actually needed was a covered outdoor space big enough to hold a market or a wedding or a town meeting."
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The plan wraps the interior program around a central courtyard covered by a shallow timber roof, forty metres on a side. The roof is carried on eight tree columns. The interior rooms open onto the courtyard in good weather and close up in winter without much fuss."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="In the two years since it opened the courtyard has hosted a farmer's market, three funerals, nine weddings, the annual school play, and a protest about traffic on the main road. The gallery is nice. The auditorium is fine. The courtyard is the building."
                    />
                </container>
            </story>
            <facts
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Project facts"
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <facts-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;
  &lt;dt&gt;Program&lt;/dt&gt;
  &lt;dd&gt;Gallery, auditorium, cafe, courtyard&lt;/dd&gt;
  &lt;dt&gt;Size&lt;/dt&gt;
  &lt;dd&gt;2,100 m2 indoor, 1,600 m2 courtyard&lt;/dd&gt;
  &lt;dt&gt;Structure&lt;/dt&gt;
  &lt;dd&gt;Glulam tree columns, timber roof deck&lt;/dd&gt;
  &lt;dt&gt;Budget&lt;/dt&gt;
  &lt;dd&gt;$8.4M&lt;/dd&gt;
  &lt;dt&gt;Completion&lt;/dt&gt;
  &lt;dd&gt;Spring 2022&lt;/dd&gt;
&lt;/dl&gt;"
                    />
                </container>
            </facts>
