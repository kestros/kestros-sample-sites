<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Residential, cultural and civic, adaptive reuse, and landscape work."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="Services"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Services"
                    />
                    <heading
                            headingText="What we take on."
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A short list. We keep the practice narrow on purpose and we are happy to recommend other firms when a project is not a fit."
                    />
                </container>
            </hero>
            <list
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <residential-heading
                            headingText="Residential"
                            headingType="h3"
                            inlineVariations="uk-heading-bullet"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <residential-body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="New-build houses and significant renovations, from infill lots to coastline properties. We work at any scale that fits on a residential plan set."
                    />
                    <cultural-and-civic-heading
                            headingText="Cultural and civic"
                            headingType="h3"
                            inlineVariations="uk-heading-bullet"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <cultural-and-civic-body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Small-to-mid-sized public buildings: libraries, community centres, galleries, pavilions. Most of these start as competitions and all of them start with a long walk around the site."
                    />
                    <adaptive-reuse-heading
                            headingText="Adaptive reuse"
                            headingType="h3"
                            inlineVariations="uk-heading-bullet"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <adaptive-reuse-body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Old buildings that want a second life. We are particular about what we take on here. If the old building has nothing to say we are usually not the right firm."
                    />
                    <landscape-and-site-heading
                            headingText="Landscape and site"
                            headingType="h3"
                            inlineVariations="uk-heading-bullet"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <landscape-and-site-body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="When a project needs it, we work with landscape architects from the first week. Increasingly we think of this as the same work, not a discipline we subcontract out."
                    />
                </container>
            </list>
            <engagement
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="How an engagement runs."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A typical project starts with an introductory meeting and a site walk, usually at no cost. If we are a good fit on both sides we do a short paid feasibility phase, which is where we figure out whether the project is worth doing and how much it is likely to cost."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="From there the phases are conventional: schematic design, design development, construction documents, bidding, construction administration. We run our side of the process with one project lead and the appropriate junior staff on each phase. The principal who signed your contract will still be looking at the drawings on the last day."
                    />
                    <p3
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="If you would like to talk about a project, the contact page is the right place to start."
                    />
                </container>
            </engagement>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
