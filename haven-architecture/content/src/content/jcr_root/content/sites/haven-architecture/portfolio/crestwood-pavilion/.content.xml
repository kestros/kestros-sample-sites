            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <meta
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Public pavilion. Crestwood Park. 2020. Completed."
                    />
                    <heading
                            headingText="Crestwood Pavilion"
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A small park pavilion the city asked us to build for $180k and finished under budget."
                    />
                    <hero-image
                            altText="Crestwood Pavilion"
                            imagePath="https://images.unsplash.com/photo-1448630360428-65456885c650?w=1800&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                    />
                </container>
            </hero>
            <story
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <p0
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Crestwood was a tight brief with a tight budget. The city needed a sheltered gathering space in an under-used park, with room for a farmer's market on weekends and nothing much the rest of the time. They wanted it built cheap and built fast."
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="We chose a simple steel-frame canopy and timber in-fill, prefabricated offsite in sections that could arrive on a flatbed and be bolted together in a week. The shape is a shallow hip that catches afternoon shade on the west and sheds rain north into a swale."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="We came in at $167,000, six percent under the allocated budget, with the leftover money going to benches and a water fountain. It has been up for four years and nobody has complained about it once."
                    />
                </container>
            </story>
            <facts
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Project facts"
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <facts-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text=" &lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;   &lt;dt&gt;Program&lt;/dt&gt;   &lt;dd&gt;Covered pavilion, benches, water fountain&lt;/dd&gt;   &lt;dt&gt;Footprint&lt;/dt&gt;   &lt;dd&gt;110 m2&lt;/dd&gt;   &lt;dt&gt;Budget&lt;/dt&gt;   &lt;dd&gt;$180,000&lt;/dd&gt;   &lt;dt&gt;Actual&lt;/dt&gt;   &lt;dd&gt;$167,000&lt;/dd&gt;   &lt;dt&gt;Built&lt;/dt&gt;   &lt;dd&gt;2020&lt;/dd&gt; &lt;/dl&gt;"
                    />
                </container>
            </facts>
