<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Linden Residence. Private residence. Inner city, infill lot. 2021."
            jcr:primaryType="nt:unstructured"
            jcr:title="Linden Residence"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <meta
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Private residence. Inner city, infill lot. 2021. Completed."
                    />
                    <heading
                            headingText="Linden Residence"
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="An infill house on a narrow lot that borrows light from its neighbors."
                    />
                    <hero-image
                            altText="Linden Residence"
                            imagePath="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=1800&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                    />
                </container>
            </hero>
            <story
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <p0
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Linden sits on a lot five metres wide between two older brick houses. The constraint of the site forced the diagram: everything happens front-to-back, not side-to-side, and every room has to earn its borrowed light."
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The front of the house is a quiet brick facade that matches the street. The back opens entirely to a small garden with a high east-facing wall. The middle of the house is a full-height stair that doubles as a lightwell, pulling sun from the roof down to the kitchen. We spent more time on that stair than on any other part of the project."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="The owners have three children and a dog. The house works because we designed for the dog first."
                    />
                </container>
            </story>
            <facts
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Project facts"
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <facts-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text=" &lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;   &lt;dt&gt;Size&lt;/dt&gt;   &lt;dd&gt;180 m2 on 95 m2 lot&lt;/dd&gt;   &lt;dt&gt;Width&lt;/dt&gt;   &lt;dd&gt;5.1 metres&lt;/dd&gt;   &lt;dt&gt;Key move&lt;/dt&gt;   &lt;dd&gt;Full-height stair as lightwell&lt;/dd&gt;   &lt;dt&gt;Completion&lt;/dt&gt;   &lt;dd&gt;2021&lt;/dd&gt; &lt;/dl&gt;"
                    />
                </container>
            </facts>
            <more-work
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="More work"
                    />
                    <heading
                            headingText="Related projects."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <others
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text=" &lt;div class=&quot;uk-grid uk-child-width-1-3@m&quot; uk-grid&gt;    &lt;div&gt;     &lt;a href=&quot;/content/sites/haven-architecture/portfolio/meridian-house.html&quot; class=&quot;uk-link-reset&quot;&gt;       &lt;img src=&quot;https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1800&amp;q=80&quot; alt=&quot;Meridian House&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;       &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Private residence. 2023&lt;/p&gt;       &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Meridian House&lt;/h4&gt;     &lt;/a&gt;   &lt;/div&gt;   &lt;div&gt;     &lt;a href=&quot;/content/sites/haven-architecture/portfolio/ashford-cultural-centre.html&quot; class=&quot;uk-link-reset&quot;&gt;       &lt;img src=&quot;https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=1800&amp;q=80&quot; alt=&quot;Ashford Cultural Centre&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;       &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Cultural institution. 2022&lt;/p&gt;       &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Ashford Cultural Centre&lt;/h4&gt;     &lt;/a&gt;   &lt;/div&gt;   &lt;div&gt;     &lt;a href=&quot;/content/sites/haven-architecture/portfolio/crestwood-pavilion.html&quot; class=&quot;uk-link-reset&quot;&gt;       &lt;img src=&quot;https://images.unsplash.com/photo-1448630360428-65456885c650?w=1800&amp;q=80&quot; alt=&quot;Crestwood Pavilion&quot; style=&quot;width: 100%; height: 220px; object-fit: cover;&quot; /&gt;       &lt;p class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-top uk-margin-remove-bottom&quot;&gt;Public pavilion. 2020&lt;/p&gt;       &lt;h4 class=&quot;uk-h5 uk-margin-remove-top&quot;&gt;Crestwood Pavilion&lt;/h4&gt;     &lt;/a&gt;   &lt;/div&gt; &lt;/div&gt;"
                    />
                </container>
            </more-work>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
