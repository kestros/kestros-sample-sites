<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Three tiers. Per-app pricing. No hidden enterprise line."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="Pricing"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Pricing"
                    />
                    <heading
                            headingText="Three tiers. No hidden ones."
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="If you are one person with a side project, start on Hobby. If you are a small team with production traffic, Pro is almost certainly what you want. If you are big enough to need audit logs and SSO, there is Team."
                    />
                </container>
            </hero>
            <plans
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <plan-cards
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;div class=&quot;uk-grid uk-child-width-1-3@m uk-grid-small&quot; uk-grid&gt;

  &lt;div&gt;
    &lt;div class=&quot;uk-card uk-card-default uk-card-body&quot;&gt;
      
      &lt;h3 class=&quot;uk-card-title uk-margin-small-bottom&quot;&gt;Hobby&lt;/h3&gt;
      &lt;div class=&quot;uk-heading-medium uk-margin-remove&quot;&gt;$0&lt;/div&gt;
      &lt;p class=&quot;uk-text-small uk-text-muted uk-margin-remove-top&quot;&gt;forever&lt;/p&gt;
      &lt;p class=&quot;uk-text-small&quot;&gt;For side projects and personal apps.&lt;/p&gt;
      &lt;ul class=&quot;uk-list uk-list-bullet uk-text-small&quot;&gt;&lt;li&gt;1 production app&lt;/li&gt;&lt;li&gt;3 preview environments&lt;/li&gt;&lt;li&gt;30 days of logs&lt;/li&gt;&lt;li&gt;2 GB outbound per month&lt;/li&gt;&lt;li&gt;Community support&lt;/li&gt;&lt;/ul&gt;
      &lt;a href=&quot;#&quot; class=&quot;uk-button uk-button-default uk-width-1-1&quot;&gt;Start for free&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;div class=&quot;uk-card uk-card-primary uk-box-shadow-large uk-card-body&quot;&gt;
      &lt;div class=&quot;uk-text-meta uk-text-uppercase uk-margin-small-bottom&quot;&gt;Most common&lt;/div&gt;
      &lt;h3 class=&quot;uk-card-title uk-margin-small-bottom&quot;&gt;Pro&lt;/h3&gt;
      &lt;div class=&quot;uk-heading-medium uk-margin-remove&quot;&gt;$18&lt;/div&gt;
      &lt;p class=&quot;uk-text-small uk-text-muted uk-margin-remove-top&quot;&gt;per app, per month&lt;/p&gt;
      &lt;p class=&quot;uk-text-small&quot;&gt;For small teams with real users.&lt;/p&gt;
      &lt;ul class=&quot;uk-list uk-list-bullet uk-text-small&quot;&gt;&lt;li&gt;Unlimited production apps&lt;/li&gt;&lt;li&gt;Unlimited preview environments&lt;/li&gt;&lt;li&gt;90 days of logs&lt;/li&gt;&lt;li&gt;100 GB outbound per month&lt;/li&gt;&lt;li&gt;Email support, 1 business day&lt;/li&gt;&lt;li&gt;Custom domains&lt;/li&gt;&lt;/ul&gt;
      &lt;a href=&quot;#&quot; class=&quot;uk-button uk-button-primary uk-width-1-1&quot;&gt;Start a 14 day trial&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;div class=&quot;uk-card uk-card-default uk-card-body&quot;&gt;
      
      &lt;h3 class=&quot;uk-card-title uk-margin-small-bottom&quot;&gt;Team&lt;/h3&gt;
      &lt;div class=&quot;uk-heading-medium uk-margin-remove&quot;&gt;$60&lt;/div&gt;
      &lt;p class=&quot;uk-text-small uk-text-muted uk-margin-remove-top&quot;&gt;per app, per month&lt;/p&gt;
      &lt;p class=&quot;uk-text-small&quot;&gt;For teams running a few production apps.&lt;/p&gt;
      &lt;ul class=&quot;uk-list uk-list-bullet uk-text-small&quot;&gt;&lt;li&gt;Everything in Pro&lt;/li&gt;&lt;li&gt;1 year of logs&lt;/li&gt;&lt;li&gt;500 GB outbound per month&lt;/li&gt;&lt;li&gt;Priority email support&lt;/li&gt;&lt;li&gt;SSO and audit log&lt;/li&gt;&lt;li&gt;A human to call once a quarter&lt;/li&gt;&lt;/ul&gt;
      &lt;a href=&quot;#&quot; class=&quot;uk-button uk-button-default uk-width-1-1&quot;&gt;Contact us&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;"
                    />
                </container>
            </plans>
            <faq
                    inlineVariations="uk-section uk-section-muted"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <heading
                            headingText="Frequently asked."
                            headingType="h2"
                            inlineVariations="uk-heading-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <faq-list
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="
&lt;dl class=&quot;uk-description-list uk-description-list-divider&quot;&gt;

  &lt;dt&gt;Who is this for?&lt;/dt&gt;
  &lt;dd class=&quot;uk-text-muted&quot;&gt;Small teams and independent developers shipping web apps. If you have a full DevOps org you will probably find Launchpad too opinionated. If you are one person deploying a side project on a Saturday, this is aimed squarely at you.&lt;/dd&gt;
  &lt;dt&gt;What runs under the hood?&lt;/dt&gt;
  &lt;dd class=&quot;uk-text-muted&quot;&gt;We run your app in firecracker microVMs on our own metal in two data centers. The database add-ons run on managed Postgres with daily point-in-time backups. You can see the full stack on our status page.&lt;/dd&gt;
  &lt;dt&gt;Where is my data?&lt;/dt&gt;
  &lt;dd class=&quot;uk-text-muted&quot;&gt;East coast and west coast, by default. EU region is in beta for Pro and Team customers. You pick the region at app creation time and can move an app between regions with one command, though the traffic cut-over takes a minute.&lt;/dd&gt;
  &lt;dt&gt;Can I bring my own domain?&lt;/dt&gt;
  &lt;dd class=&quot;uk-text-muted&quot;&gt;Yes. Free on the Pro and Team plans, not supported on Hobby. We issue certificates automatically and rotate them ten days before expiry.&lt;/dd&gt;
  &lt;dt&gt;Do you do autoscaling?&lt;/dt&gt;
  &lt;dd class=&quot;uk-text-muted&quot;&gt;Yes, but only between bounds you set. We do not automatically scale up to whatever you can afford. The default is &quot;one to three instances&quot;. You can change it.&lt;/dd&gt;
&lt;/dl&gt;"
                    />
                </container>
            </faq>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
