                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/button"
                            text="Contact Us"
                            href="/content/sites/launchpad-io/contact"
                            link="/content/sites/launchpad-io/contact"
                            variations="[/apps/kestros/commons/components/content/button/ui-kit-lib/3.23.6/variations/style/uk-button-default,/apps/kestros/commons/components/content/button/ui-kit-lib/3.23.6/variations/size/uk-button-large]"/>
