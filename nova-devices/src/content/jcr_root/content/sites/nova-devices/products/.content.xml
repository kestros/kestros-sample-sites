<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Explore the Nova product lineup."
            jcr:primaryType="nt:unstructured"
            jcr:title="Products"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <!-- Heading -->
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/style/nova-section-default,/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/size/nova-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/layouts/default"
                        variations="[/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/variations/size/nova-container-narrow]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h1"
                            text="Products"
                            layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                            variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/font-size/nova-heading-hero,/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                    <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Innovation at every scale."
                            variations="[/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/font-size/nova-text-lead,/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-color/nova-text-muted,/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                </container>
            </section>
            <!-- Product Grid -->
            <section-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/style/nova-section-default,/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/size/nova-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/layouts/default"
                        variations="[]">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            layout="/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/layouts/default"
                            variations="[/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/variations/gap/nova-grid-gap-large]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/image"
                                    altText="Nova Phone"
                                    imagePath="TODO: Nova Phone floating on dark background"
                                    layout="/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/variations/border-radius/nova-image-rounded]"/>
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Nova Phone"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/image"
                                    altText="Nova Book"
                                    imagePath="TODO: Nova Book half-open on dark background"
                                    layout="/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/variations/border-radius/nova-image-rounded]"/>
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Nova Book"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/image"
                                    altText="Nova Watch"
                                    imagePath="TODO: Nova Watch on dark background with glowing display"
                                    layout="/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/variations/border-radius/nova-image-rounded]"/>
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Nova Watch"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                        </column-3>
                    </grid>
                </container>
            </section-1>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
    <nova-phone/>
    <nova-book/>
    <nova-watch/>
</jcr:root>
