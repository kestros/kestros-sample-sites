<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Nova was founded with a simple belief: technology should empower everyone."
            jcr:primaryType="nt:unstructured"
            jcr:title="About"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <!-- Company Story -->
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/style/nova-section-default,/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/size/nova-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/layouts/default"
                        variations="[]">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            layout="/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/layouts/50-50"
                            variations="[/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/variations/alignment/nova-grid-align-center,/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/variations/gap/nova-grid-gap-large]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h2"
                                    text="Our Story"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/font-size/nova-heading-xlarge]"/>
                            <richtext
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;Nova was founded in 2010 with a simple belief: technology should empower everyone. We design products that seamlessly integrate into your life, combining breakthrough innovation with intuitive simplicity.&lt;/p&gt;&lt;p&gt;From our first device to our latest innovations, every product reflects our commitment to pushing the boundaries of what's possible while keeping the human experience at the center of everything we create.&lt;/p&gt;"
                                    layout="/apps/kestros/commons/components/content/richtext/nova-css-lib/0.3.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/richtext/nova-css-lib/0.3.0/variations/text-color/nova-text-muted]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/image"
                                    altText="Nova headquarters"
                                    imagePath="TODO: Aerial view of Nova campus - glass and steel buildings surrounded by trees"
                                    layout="/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/variations/border-radius/nova-image-rounded]"/>
                        </column-2>
                    </grid>
                </container>
            </section>
            <!-- Values -->
            <section-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/style/nova-section-dark,/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/size/nova-section-large]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/layouts/default"
                        variations="[/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/variations/size/nova-container-narrow]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Our Values"
                            layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                            variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/font-size/nova-heading-large,/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-color/nova-text-light,/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            layout="/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/layouts/default"
                            variations="[/apps/kestros/commons/components/structure/grid/nova-css-lib/0.2.0/variations/gap/nova-grid-gap-large]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Innovation"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-color/nova-text-light,/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="We challenge convention and reimagine what technology can do."
                                    variations="[/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-color/nova-text-muted,/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Privacy"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-color/nova-text-light,/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Privacy is a fundamental human right. It's built into everything we make."
                                    variations="[/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-color/nova-text-muted,/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Environment"
                                    layout="/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/layouts/default"
                                    variations="[/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-color/nova-text-light,/apps/kestros/commons/components/content/heading/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="We're committed to making every product carbon neutral by 2030."
                                    variations="[/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-color/nova-text-muted,/apps/kestros/commons/components/content/text/nova-css-lib/0.1.0/variations/text-align/nova-text-center]"/>
                        </column-3>
                    </grid>
                </container>
            </section-1>
            <!-- Full-width Image -->
            <section-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[/apps/kestros/commons/components/structure/section/nova-css-lib/0.1.0/variations/modifiers/nova-section-no-padding]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        layout="/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/layouts/default"
                        variations="[/apps/kestros/commons/components/structure/container/nova-css-lib/0.1.0/variations/size/nova-container-full]">
                    <image
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                            altText="Nova team at work"
                            imagePath="TODO: Wide panoramic shot of Nova design lab with engineers collaborating"
                            layout="/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/layouts/default"
                            variations="[/apps/kestros/commons/components/content/image/nova-css-lib/0.2.0/variations/modifiers/nova-image-full-width]"/>
                </container>
            </section-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
