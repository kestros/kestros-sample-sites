<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Get in touch with the Bark &amp; Bowl team. We are here to help with orders, nutrition questions, or anything else."
            jcr:primaryType="nt:unstructured"
            jcr:title="Contact Us"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Contact Us"
                            variations="[]"/>
                    <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Have a question about your order, need help choosing the right food for your pup, or just want to share a cute dog photo? We would love to hear from you."
                            variations="[]"/>
                </container>
            </section>
            <section-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            variations="[]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Email"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="hello@barkandbowl.com"
                                    variations="[]"/>
                            <text-1
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="We respond within 24 hours, Monday through Friday."
                                    variations="[]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Phone"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="1-800-BARK-BOWL (1-800-227-5269)"
                                    variations="[]"/>
                            <text-1
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Monday - Friday: 8am - 6pm PST"
                                    variations="[]"/>
                            <text-2
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Saturday: 9am - 3pm PST"
                                    variations="[]"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="Mailing Address"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Bark &amp; Bowl"
                                    variations="[]"/>
                            <text-1
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="742 Evergreen Terrace, Suite 200"
                                    variations="[]"/>
                            <text-2
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Portland, OR 97205"
                                    variations="[]"/>
                        </column-3>
                    </grid>
                </container>
            </section-1>
            <section-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h3"
                            text="Common Questions"
                            variations="[]"/>
                    <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Before reaching out, you might find your answer in our FAQ or Nutrition Guide."
                            variations="[]"/>
                    <button-group
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/button-group"
                            variations="[]">
                        <button
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/button"
                                label="FAQ"
                                text="FAQ"
                                href="/content/sites/bark-and-bowl/faq"
                                link="/content/sites/bark-and-bowl/faq"
                                variations="[]"/>
                        <button-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/button"
                                label="Nutrition Guide"
                                text="Nutrition Guide"
                                href="/content/sites/bark-and-bowl/nutrition-guide"
                                link="/content/sites/bark-and-bowl/nutrition-guide"
                                variations="[]"/>
                    </button-group>
                </container>
            </section-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
