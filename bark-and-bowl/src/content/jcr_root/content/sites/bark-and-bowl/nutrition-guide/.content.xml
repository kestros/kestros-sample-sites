<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Everything you need to know about feeding your dog well - portion guides, nutritional info, and tips from our veterinary nutritionists."
            jcr:primaryType="nt:unstructured"
            jcr:title="Nutrition Guide"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Nutrition Guide"
                            variations="[]"/>
                    <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Feeding your dog well does not have to be complicated. Our veterinary nutritionists have put together answers to the most common questions we hear from pet parents."
                            variations="[]"/>
                </container>
            </section>
            <section-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <accordion
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/accordion"
                            variations="[]">
                        <panel-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/structure/accordion-panel"
                                title="How much should I feed my dog?"
                                variations="[]">
                            <richtext
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;Portion sizes depend on your dog's weight, age, activity level, and body condition. As a general guideline:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Small dogs (under 20 lbs):&lt;/strong&gt; 1/2 to 1 cup per day&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Medium dogs (20-50 lbs):&lt;/strong&gt; 1 to 2 cups per day&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Large dogs (50-100 lbs):&lt;/strong&gt; 2 to 3.5 cups per day&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Giant breeds (100+ lbs):&lt;/strong&gt; 3.5 to 5 cups per day&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Our fresh meal plans are pre-portioned based on your dog's profile, so the guesswork is already done for you.&lt;/p&gt;"
                                    variations="[]"/>
                        </panel-1>
                        <panel-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/structure/accordion-panel"
                                title="What does AAFCO complete and balanced mean?"
                                variations="[]">
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="AAFCO (Association of American Feed Control Officials) sets nutrient profiles that define the minimum and maximum levels of nutrients required for a dog food to be considered complete and balanced. When a food meets AAFCO standards, it means it provides all the essential nutrients your dog needs as their sole diet. All Bark &amp; Bowl recipes meet AAFCO standards for all life stages."
                                    variations="[]"/>
                        </panel-2>
                        <panel-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/structure/accordion-panel"
                                title="Should I choose grain-free or grain-inclusive?"
                                variations="[]">
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="For most dogs, grain-inclusive diets are perfectly healthy and provide excellent sources of fiber and energy. True grain allergies in dogs are rare. We offer both options so you can choose what works best for your pup. If your dog has a diagnosed grain sensitivity, our Salmon &amp; Lentil fresh recipe and our Salmon dry kibble are grain-free. When in doubt, consult your veterinarian."
                                    variations="[]"/>
                        </panel-3>
                        <panel-4
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/structure/accordion-panel"
                                title="How do I transition my dog to Bark &amp; Bowl?"
                                variations="[]">
                            <richtext
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/richtext"
                                    text="&lt;p&gt;A gradual transition over 7 to 10 days is best to avoid digestive upset:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Days 1-3:&lt;/strong&gt; 25% Bark &amp;amp; Bowl, 75% current food&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Days 4-6:&lt;/strong&gt; 50% Bark &amp;amp; Bowl, 50% current food&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Days 7-9:&lt;/strong&gt; 75% Bark &amp;amp; Bowl, 25% current food&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Day 10:&lt;/strong&gt; 100% Bark &amp;amp; Bowl&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Some dogs with sensitive stomachs may need a longer transition period. If you notice loose stools, slow down the transition.&lt;/p&gt;"
                                    variations="[]"/>
                        </panel-4>
                        <panel-5
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/structure/accordion-panel"
                                title="Can I mix fresh food with kibble?"
                                variations="[]">
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Absolutely. Many pet parents use our fresh food as a topper or mix it with kibble. Even replacing 25% of your dog's diet with fresh food can provide significant health benefits including better digestion, shinier coat, and more energy. Our fresh recipes and kibble are designed to complement each other."
                                    variations="[]"/>
                        </panel-5>
                    </accordion>
                </container>
            </section-1>
            <section-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h3"
                            text="Still have questions?"
                            variations="[]"/>
                    <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Our team includes board-certified veterinary nutritionists who are happy to help. Reach out anytime."
                            variations="[]"/>
                    <button
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/button"
                            label="Contact Us"
                            text="Contact Us"
                            href="/content/sites/bark-and-bowl/contact"
                            link="/content/sites/bark-and-bowl/contact"
                            variations="[]"/>
                </container>
            </section-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
