<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:description="Learn about Bark &amp; Bowl - our story, our mission, and why we are passionate about feeding dogs better."
            jcr:primaryType="nt:unstructured"
            jcr:title="About Us"
            kes:template="/libs/kestros/commons/base-page-template"
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area">
            <section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Our Story"
                            variations="[]"/>
                    <image
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                            altText="Bark and Bowl founders with their dogs"
                            imagePath="TODO: Team photo - two founders standing in their kitchen/workshop with three dogs at their feet, natural light, candid and warm"
                            variations="[]"/>
                    <richtext
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="&lt;p&gt;Bark &amp;amp; Bowl started in 2019 when our founders, Jamie and Alex, watched their rescue dog Max turn his nose up at yet another bag of over-processed kibble. After a trip to the vet revealed that Max's dull coat and low energy were tied to his diet, they started cooking for him at home.&lt;/p&gt;&lt;p&gt;Within weeks, Max was a different dog - bright-eyed, energetic, and actually excited about mealtime. Friends started asking what they were feeding him, and before long, Jamie and Alex were cooking for half the dogs in the neighborhood.&lt;/p&gt;&lt;p&gt;That kitchen experiment became Bark &amp;amp; Bowl. Today, we work with a team of veterinary nutritionists to craft recipes that are complete, balanced, and made from ingredients you can actually recognize. Every batch is prepared in our USDA-inspected kitchen using the same quality of food you would serve your family.&lt;/p&gt;"
                            variations="[]"/>
                </container>
            </section>
            <section-1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="Our Mission"
                            variations="[]"/>
                    <text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="We believe every dog deserves to eat real food. Our mission is to make fresh, nutritious dog food accessible to pet parents everywhere - without the guesswork, without the fillers, and without the guilt."
                            variations="[]"/>
                </container>
            </section-1>
            <section-2
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    variations="[]">
                <container
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                        elementType="main"
                        variations="[]">
                    <heading
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                            level="h2"
                            text="By the Numbers"
                            variations="[]"/>
                    <grid
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/grid"
                            variations="[]">
                        <column-1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="50,000+"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Happy dogs fed every month"
                                    variations="[]"/>
                        </column-1>
                        <column-2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="12"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Vet-formulated recipes"
                                    variations="[]"/>
                        </column-2>
                        <column-3
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kestros/commons/components/content-area">
                            <heading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/heading"
                                    level="h3"
                                    text="0"
                                    variations="[]"/>
                            <text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/text"
                                    text="Artificial preservatives, fillers, or by-products"
                                    variations="[]"/>
                        </column-3>
                    </grid>
                </container>
            </section-2>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
