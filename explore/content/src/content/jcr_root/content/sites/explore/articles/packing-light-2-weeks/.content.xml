                    />
                    <hero-image
                            altText="Packing light for two weeks anywhere"
                            imagePath="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=1600&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
