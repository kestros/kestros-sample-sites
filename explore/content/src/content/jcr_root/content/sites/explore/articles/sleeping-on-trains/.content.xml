                            text="Story"
                    />
                    <heading
                            headingText="The quiet joy of sleeping on trains"
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <dek
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="You fall asleep in one country and wake up in another. No hotel bill, no security line."
                    />
                    <hero-image
                            altText="The quiet joy of sleeping on trains"
                            imagePath="https://images.unsplash.com/photo-1474487548417-781cb71495f3?w=1600&amp;q=80"
                            inlineVariations="uk-width-1-1"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/image"
                    />
                    <byline
                            inlineVariations="uk-text-small"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Priya Chen. Photographer. Not a morning person.. 5 min read."
                    />
                </container>
            </hero>
            <body
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <p0
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Night trains are the second best way to travel and quietly the best. You go to sleep in one city and wake up in another. The transit happens while you are unconscious. You do not have to think about it."
                    />
                    <p1
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Europe still has them. Eastern Europe has more. India runs the largest network in the world. There is a beautiful one in Vietnam between Hanoi and Hue. The trick is to book a sleeper, not a seat. Pay the extra fifteen dollars. The bunk is the difference between a night of sleep and a bad joke in the morning."
                    />
                    <p2
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Pack earplugs. Pack a snack for when you wake up at 3am for no reason. Tip the conductor if they are good, which they usually are."
                    />
                </container>
            </body>
