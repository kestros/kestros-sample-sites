                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/container"
                    >
                        <eyebrow
                                inlineVariations="uk-text-meta uk-text-uppercase"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Story"
                        />
                        <heading
                                headingText="Why shoulder season is the real travel season"
                                headingType="h1"
                                inlineVariations="uk-heading-medium"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                        />
                        <dek
                                inlineVariations="uk-text-lead"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Cheaper flights, emptier trails, and hosts who still remember how to be hospitable."
                        />
                        <hero-image
                                altText="Why shoulder season is the real travel season"
                                imagePath="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=1600&amp;q=80"
                                inlineVariations="uk-width-1-1"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/image"
                        />
                        <byline
                                inlineVariations="uk-text-small"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Jane Holloway. Editor, 20 years on the road. 6 min read."
                        />
                    </container>
                </hero>
                <body
                        inlineVariations="uk-section uk-section-default"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/section"
                >
                    <container
                            inlineVariations="uk-container"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/structure/container"
                    >
                        <p0
                                inlineVariations="uk-text-lead"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Everybody goes in summer. That is the whole problem. Hotels fill up, trains fill up, and by the middle of July the people who live in the places you came to see are exhausted."
                        />
                        <p1
                                inlineVariations="uk-text-lead"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Shoulder season is the four to six weeks on either side of high season. Late April in Kyoto. Early November in Marrakech. March in the Andes, when the rains have let up but the buses still run. The weather is a small gamble. Everything else is better."
                        />
                        <p2
                                inlineVariations="uk-text-lead"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="The fix is not complicated. Move your dates by three weeks. Bring a jacket you would not have needed in July. Book one hotel in advance and wing the rest. You will save a thousand dollars and the people you meet will be nicer about the fact that you showed up."
                        />
                    </container>
                </body>
