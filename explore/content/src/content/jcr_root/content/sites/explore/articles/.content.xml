        <jcr:content
                jcr:description="Cheaper flights, emptier trails, and hosts who still remember how to be hospitable."
                jcr:primaryType="nt:unstructured"
                jcr:title="Why shoulder season is the real travel season"
                kes:template="/libs/kestros/commons/base-site-template"
                sling:resourceType="kestros/commons/components/kestros-base-page"
        >
            <header
