{
  "jcr:primaryType": "nt:unstructured",
  "jcr:title": "Season Stat",
  "group": "League Demo",
  "classPath": "io.kestros.samples.leaguedemo.datasources.SeasonStatHeadingDataSource",
  "edit": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/cms2/dialog",
    "content": {
      "jcr:primaryType": "nt:unstructured",
      "metric": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/selectfield",
        "label": "Metric",
        "name": "metric",
        "description": "Which season-at-a-glance counter this heading displays.",
        "options": {
          "matchesPlayed": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Matches played",
            "value": "matchesPlayed",
            "selected": true
          },
          "totalGoals": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Total goals scored",
            "value": "totalGoals",
            "selected": false
          },
          "goalsPerMatch": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Goals per match",
            "value": "goalsPerMatch",
            "selected": false
          }
        }
      },
      "level": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/selectfield",
        "label": "Heading level",
        "name": "level",
        "description": "HTML heading level. Default h3 for stat displays.",
