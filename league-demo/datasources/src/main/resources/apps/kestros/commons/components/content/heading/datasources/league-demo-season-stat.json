          "h1": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Heading 1",
            "value": "h1",
            "selected": false
          },
          "h2": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Heading 2",
            "value": "h2",
            "selected": false
          },
          "h3": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Heading 3",
            "value": "h3",
            "selected": true
          },
          "h4": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Heading 4",
            "value": "h4",
            "selected": false
          },
          "h5": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Heading 5",
            "value": "h5",
            "selected": false
          },
          "h6": {
            "jcr:primaryType": "nt:unstructured",
            "text": "Heading 6",
            "value": "h6",
            "selected": false
          }
        }
      }
    }
