{
  "jcr:primaryType": "nt:unstructured",
  "jcr:title": "Matchweek Progress",
  "group": "League Demo",
  "classPath": "io.kestros.samples.leaguedemo.datasources.MatchweekProgressTextDataSource",
  "edit": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/cms2/dialog",
    "content": {
      "jcr:primaryType": "nt:unstructured",
      "prefix": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Prefix",
        "propertyName": "prefix",
        "description": "Text shown before the computed matchweek number (e.g. 'Updated through Matchweek').",
        "defaultValue": "Updated through Matchweek"
      },
      "suffix": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Suffix",
        "propertyName": "suffix",
        "description": "Text shown after the matchweek number — commonly a sentence continuation (e.g. ', plus the fixtures coming this weekend.').",
        "defaultValue": ""
      },
      "offset": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/numberfield",
        "label": "Offset",
        "propertyName": "offset",
        "description": "Integer added to the current matchweek (e.g. 1 to refer to the next matchweek). Negative values look back.",
        "defaultValue": "0"
      }
    }
  }
}
