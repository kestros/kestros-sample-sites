<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Site"
>
    <jcr:content
            jcr:description="The official home of the Meridian Premier League -- ten clubs, eighteen matchweeks, one champion."
            jcr:primaryType="nt:unstructured"
            jcr:title="Meridian Premier League"
            kes:template="/libs/kestros/commons/base-site-template"
            kes:theme="/etc/ui-frameworks/league-framework-v2/versions/0.0.1/themes/default"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <!-- HEADER -->
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        >
            <top-navigation
                    brandName="Meridian Premier League"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation"
            >
                <nav-news
                        href="/content/sites/league-demo/news.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="News"/>
                <nav-standings
                        href="/content/sites/league-demo/standings.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Standings"/>
                <nav-schedule
                        href="/content/sites/league-demo/schedule.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Schedule"/>
                <nav-teams
                        href="/content/sites/league-demo/teams.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Teams"/>
                <nav-players
                        href="/content/sites/league-demo/players.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Players"/>
                <nav-watch
                        href="/content/sites/league-demo/watch.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Watch"/>
                <nav-tickets
                        href="/content/sites/league-demo/tickets.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Tickets"/>
                <nav-shop
                        href="/content/sites/league-demo/shop.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="Shop"/>
                <nav-about
                        href="/content/sites/league-demo/about.html"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/navigation/top-navigation-item"
                        text="About"/>
            </top-navigation>
        </header>

        <!-- MAIN -->
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <!-- Hero -->
            <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Meridian Premier League"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Season 2025-26 -- Week 12 of 18"/>
                <ctas
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/button-group"
                >
                    <standings-btn
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/button"
                            text="View Standings"
                            href="/content/sites/league-demo/standings.html"/>
                    <schedule-btn
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/button"
                            text="Full Schedule"
                            href="/content/sites/league-demo/schedule.html"/>
                </ctas>
            </hero>

            <!-- Recent Results -->
            <results-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Week 12 Results"
                        headingType="h2"/>
                <results-subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The latest scores from across the Meridian Premier League."/>
                <results-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        kes:datasource="league-demo-recent-results"/>
                <schedule-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/link"
                        text="Full Schedule and Results"
                        href="/content/sites/league-demo/schedule.html"/>
            </results-section>

            <!-- League News -->
            <news-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="League News"
                        headingType="h2"/>
                <news-cards
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                        kes:datasource="league-demo-news"
                        layout="two-columns"/>
            </news-section>

            <!-- Standings -->
            <standings-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Standings"
                        headingType="h2"/>
                <standings-subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Updated through Matchweek 12. Riverside FC lead by three points."/>
                <standings-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        kes:datasource="league-demo-standings"/>
                <full-table-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/link"
                        text="View Full Table"
                        href="/content/sites/league-demo/standings.html"/>
            </standings-section>

            <!-- Upcoming Fixtures -->
            <upcoming-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Upcoming Fixtures"
                        headingType="h2"/>
                <upcoming-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        kes:datasource="league-demo-upcoming"/>
                <schedule-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/link"
                        text="View Full Schedule"
                        href="/content/sites/league-demo/schedule.html"/>
            </upcoming-section>

            <!-- Official Partners -->
            <sponsors-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Official Partners"
                        headingType="h2"/>
                <sponsors-cards
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                        kes:datasource="league-demo-sponsors"
                        layout="four-columns"/>
            </sponsors-section>
        </main>

        <!-- FOOTER -->
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        >
            <footer-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="footer"
            >
                <footer-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid"
                >
                    <column-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <brand-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Meridian Premier League"
                                headingType="h4"/>
                        <brand-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="The official home of the MPL. Follow the 2025-26 season with live standings, fixtures, and club profiles."/>
                        <social-links
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/lists/link-list"
                        >
                            <twitter
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/link"
                                    text="Twitter" href="#"/>
                            <instagram
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/link"
                                    text="Instagram" href="#"/>
                            <youtube
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="/libs/kestros/commons/components/content/link"
                                    text="YouTube" href="#"/>
                        </social-links>
                    </column-1>
                    <column-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <competition-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Competition"
                                headingType="h5"/>
                        <competition-links
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/lists/link-list"
                        >
                            <news jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="News" href="/content/sites/league-demo/news.html"/>
                            <standings jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Standings" href="/content/sites/league-demo/standings.html"/>
                            <schedule jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Schedule &amp; Results" href="/content/sites/league-demo/schedule.html"/>
                            <teams jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Teams" href="/content/sites/league-demo/teams.html"/>
                            <players jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Players" href="/content/sites/league-demo/players.html"/>
                        </competition-links>
                    </column-2>
                    <column-3
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <fan-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Fan Zone"
                                headingType="h5"/>
                        <fan-links
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/lists/link-list"
                        >
                            <watch jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Watch Live" href="/content/sites/league-demo/watch.html"/>
                            <tickets jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Tickets" href="/content/sites/league-demo/tickets.html"/>
                            <shop jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Official Shop" href="/content/sites/league-demo/shop.html"/>
                            <community jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Community" href="/content/sites/league-demo/community.html"/>
                        </fan-links>
                    </column-3>
                    <column-4
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <about-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="About"
                                headingType="h5"/>
                        <about-links
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/lists/link-list"
                        >
                            <about-league jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="About the League" href="/content/sites/league-demo/about.html"/>
                            <season-archive jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Season Archive" href="/content/sites/league-demo/seasons.html"/>
                            <contact jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Contact" href="#"/>
                            <privacy jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/link" text="Privacy Policy" href="#"/>
                        </about-links>
                    </column-4>
                </footer-grid>
                <copyright
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="2025-26 Meridian Premier League. All rights reserved."/>
            </footer-section>
        </footer>
    </jcr:content>
</jcr:root>
