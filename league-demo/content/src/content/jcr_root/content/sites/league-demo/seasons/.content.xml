<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="Every Meridian Premier League season since the league formed."
            jcr:primaryType="nt:unstructured"
            jcr:title="Seasons"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container uk-container-large"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Archive"
                    />
                    <heading
                            headingText="Seasons past."
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="Every Meridian Premier League season since the league formed."
                    />
                </container>
            </hero>
            <list
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container uk-container-large"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <table
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="&lt;table class=&quot;uk-table uk-table-divider uk-table-middle&quot;&gt;
        &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Season&lt;/th&gt;&lt;th&gt;Champion&lt;/th&gt;&lt;th&gt;Top scorer&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
        &lt;tbody&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;strong&gt;2025-26&lt;/strong&gt; &lt;span class=&quot;uk-label uk-label-warning&quot;&gt;Current&lt;/span&gt;&lt;/td&gt;
        &lt;td&gt;In progress&lt;/td&gt;
        &lt;td class=&quot;uk-text-muted&quot;&gt;Luca Mendez (Riverside)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;strong&gt;2024-25&lt;/strong&gt; &lt;/td&gt;
        &lt;td&gt;Meridian City&lt;/td&gt;
        &lt;td class=&quot;uk-text-muted&quot;&gt;Kenji Aoki (Port Heights, 22g)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;strong&gt;2023-24&lt;/strong&gt; &lt;/td&gt;
        &lt;td&gt;Ashdown Athletic&lt;/td&gt;
        &lt;td class=&quot;uk-text-muted&quot;&gt;Ivan Petrovic (Riverside, 19g)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;strong&gt;2022-23&lt;/strong&gt; &lt;/td&gt;
        &lt;td&gt;Meridian City&lt;/td&gt;
        &lt;td class=&quot;uk-text-muted&quot;&gt;Jamal Washington (Ashdown, 18g)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;strong&gt;2021-22&lt;/strong&gt; &lt;/td&gt;
        &lt;td&gt;Riverside FC&lt;/td&gt;
        &lt;td class=&quot;uk-text-muted&quot;&gt;Samuel Park (Oakhill, 17g)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;strong&gt;2020-21&lt;/strong&gt; &lt;/td&gt;
        &lt;td&gt;Northside United&lt;/td&gt;
        &lt;td class=&quot;uk-text-muted&quot;&gt;Jamal Washington (Ashdown, 20g)&lt;/td&gt;
      &lt;/tr&gt;&lt;/tbody&gt;
      &lt;/table&gt;"
                    />
                </container>
            </list>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
