<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="Season Archive"
            jcr:description="Every Meridian Premier League season since the inaugural 2019-20 campaign."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Season Archive"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        kes:datasource="league-demo-seasons-hero"/>
            </page-header>

            <!-- Champions Roll of Honour -->
            <champions-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Roll of Honour"
                        headingType="h2"/>
                <champs-subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Every MPL champion, runner-up, and Golden Boot winner since 2019."/>
                <champions-cards
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                        kes:datasource="league-demo-champions"
                        layout="two-columns"/>
            </champions-section>

            <!-- Season Records -->
            <records-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="All-Time Records"
                        headingType="h2"/>
                <records-intro
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        kes:datasource="league-demo-records-intro"/>
                <records-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Most Titles" headingType="h4"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text"
                           kes:datasource="league-demo-season-record" metric="most-titles"/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Highest Single-Season Goals" headingType="h4"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text"
                           kes:datasource="league-demo-season-record" metric="highest-single-season-goals"/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Most Runner-Up Finishes" headingType="h4"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text"
                           kes:datasource="league-demo-season-record" metric="most-runners-up"/>
                    </column-3>
                </records-grid>
            </records-section>

            <!-- Seasons Table -->
            <table-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="All Seasons"
                        headingType="h2"/>
                <seasons-intro
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Every Meridian Premier League season since the league's inception in 2019. Click any season name for the full champion, runner-up, top scorer, and competition summary."/>
                <seasons-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        variations="[/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-striped,/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-hover]"
                        kes:datasource="league-demo-seasons"/>
            </table-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
