<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="Teams"
            jcr:description="All ten clubs competing in the 2025-26 Meridian Premier League season."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="The Clubs"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Ten clubs. Over a century of combined history. One league."/>
            </page-header>
            <intro-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <intro-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The Meridian Premier League brings together ten clubs from across the region — from Stone Valley, founded in 1886 as the league's oldest, to Southshore United, established in 1947. Each one carries its own colours, traditions, and rivalries into every matchweek of the 2025-26 season."/>
            </intro-section>
            <cards-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Meet the Clubs"
                        headingType="h2"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Click any club for the squad, fixtures, and full season stats."/>
                <teams-cards
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                        kes:datasource="league-demo-teams-list"/>
            </cards-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
