<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="Season"
            jcr:description="Dynamic page template for per-season URLs via LeagueSeasonPageFilter."
            sling:resourceType="kestros/commons/components/kestros-dynamic-page"
            dynamicPageType="league-season">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <overview-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingType="h1"
                        kes:datasource="league-demo-season-name"/>
                <summary
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Full league table, fixtures, and season summary."/>
                <season-info
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        variations="[/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-striped,/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-hover]"
                        kes:datasource="league-demo-season-info"/>
            </overview-section>
            <recent-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Recent Results"
                        headingType="h2"/>
                <recent-intro
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        kes:datasource="league-demo-season-recent-intro"
                        variations="[/apps/kestros/commons/components/content/text/lfv2/0.0.1/variations/style/muted]"/>
                <recent-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        variations="[/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-striped,/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-hover]"
                        kes:datasource="league-demo-season-recent"/>
                <archive-cta
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/button-group">
                    <archive-link
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/button"
                            variations="[/apps/kestros/commons/components/content/button/bootstrap-lib/1.0.0/variations/style/btn-warning]"
                            text="Back to Season Archive"
                            href="/content/sites/league-demo/seasons.html"/>
                </archive-cta>
            </recent-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
