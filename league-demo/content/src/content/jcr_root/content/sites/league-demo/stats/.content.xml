<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="Stats"
            jcr:description="Season statistics, top scorers, and assists leaders for the 2025-26 MPL season."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Stats Centre"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="2025-26 season leaders through Matchweek 12."/>
            </page-header>

            <!-- Season at a Glance -->
            <glance-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Season at a Glance"
                        headingType="h2"/>
                <glance-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area">
                        <stat
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                kes:datasource="league-demo-season-stat"
                                metric="matchesPlayed"
                                level="h3"/>
                        <label
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Matches Played"/>
                    </column-1>
                    <column-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area">
                        <stat
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                kes:datasource="league-demo-season-stat"
                                metric="totalGoals"
                                level="h3"/>
                        <label
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Goals Scored"/>
                    </column-2>
                    <column-3
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area">
                        <stat
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                kes:datasource="league-demo-season-stat"
                                metric="goalsPerMatch"
                                level="h3"/>
                        <label
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Goals Per Match"/>
                    </column-3>
                </glance-grid>
            </glance-section>

            <!-- Top Goals + Top Assists side by side -->
            <leaders-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Season Leaders"
                        headingType="h2"/>
                <leaders-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid"
                        layout="50-50">
                    <column-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area">
                        <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Golden Boot Race"
                                headingType="h3"/>
                        <goals-table
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/table"
                                variations="[table-striped,table-hover]"
                                kes:datasource="league-demo-top-goals"/>
                    </column-1>
                    <column-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area">
                        <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Assists Leaders"
                                headingType="h3"/>
                        <assists-table
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/table"
                                variations="[table-striped,table-hover]"
                                kes:datasource="league-demo-top-assists"/>
                    </column-2>
                </leaders-grid>
            </leaders-section>

            <!-- Full Scoring Leaders table -->
            <full-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Full Scoring Leaders"
                        headingType="h2"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Top 15 goal scorers across the season with apps, goals, and assists."/>
                <full-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        variations="[table-striped,table-hover]"
                        kes:datasource="league-demo-players"/>
            </full-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
