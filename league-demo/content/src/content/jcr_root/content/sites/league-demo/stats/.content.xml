<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="Stats"
            jcr:description="Season statistics, top scorers, assists leaders, and clean sheet records for the 2025-26 MPL season."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Stats Centre"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="2025-26 season leaders through Matchweek 12."/>
            </page-header>

            <!-- Season Overview -->
            <overview-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Season at a Glance"
                        headingType="h2"/>
                <overview-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <stat-heading jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="60" headingType="h3"/>
                        <stat-label jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Matches Played"/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <stat-heading jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="175" headingType="h3"/>
                        <stat-label jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Goals Scored"/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <stat-heading jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="2.92" headingType="h3"/>
                        <stat-label jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Goals Per Match"/>
                    </column-3>
                </overview-grid>
            </overview-section>

            <!-- Top Scorers -->
            <scorers-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Golden Boot Race"
                        headingType="h2"/>
                <scorers-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The race for the 2025-26 Golden Boot. Awarded to the season's leading goal scorer."/>
                <scorers-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <s1 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="1. Marcus Fletcher" headingType="h4"/>
                        <s1d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Riverside FC -- 11 goals. 6 home, 5 away. 3 penalties."/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <s2 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="2. Carlos Vega" headingType="h4"/>
                        <s2d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Meridian City -- 10 goals. 7 from open play, 3 from set pieces."/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <s3 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="3. Omar Hassan" headingType="h4"/>
                        <s3d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Northside United -- 9 goals. All from open play."/>
                    </column-3>
                </scorers-grid>
            </scorers-section>

            <!-- Assists -->
            <assists-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Assists Leaders"
                        headingType="h2"/>
                <assists-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <a1 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="1. Liam Chen" headingType="h4"/>
                        <a1d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Meridian City -- 8 assists. League leader in chances created (42)."/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <a2 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="2. Tomas Eriksen" headingType="h4"/>
                        <a2d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Riverside FC -- 7 assists. Key playmaker from the right wing."/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <a3 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="3. Daniel Okafor" headingType="h4"/>
                        <a3d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Northside United -- 6 assists. Set-piece specialist."/>
                    </column-3>
                </assists-grid>
            </assists-section>

            <!-- Clean Sheets -->
            <cleansheets-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Clean Sheets"
                        headingType="h2"/>
                <cs-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <c1 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="1. Andre Silva" headingType="h4"/>
                        <c1d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Northside United -- 7 clean sheets. Best save percentage in the league (81%)."/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <c2 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="2. Matt Henderson" headingType="h4"/>
                        <c2d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Riverside FC -- 5 clean sheets. Commanding presence in the box."/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <c3 jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="3. Chen Wei" headingType="h4"/>
                        <c3d jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Oakhill FC -- 5 clean sheets. Set-piece threat from midfield too."/>
                    </column-3>
                </cs-grid>
            </cleansheets-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
