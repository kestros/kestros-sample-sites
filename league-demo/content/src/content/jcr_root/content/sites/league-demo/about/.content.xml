<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="About"
            jcr:description="A fictional ten-club league used to demonstrate the Kestros sport-league sample site."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    inlineVariations="bg-light">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="About the Meridian Premier League"
                        headingType="h1"/>
            </page-header>
            <content-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <overview
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The Meridian Premier League was founded in 2019 as a ten-club top-flight competition. Each season spans 18 matchweeks, with every club playing each rival once at home and once away. The bottom two clubs are relegated at the end of each campaign, while the top three qualify for European competition."/>
            </content-section>
            <format-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Format"
                        headingType="h2"/>
                <format-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Every club plays 18 league matches -- one home and one away against each of the other nine sides. A win earns three points, a draw one point, and a loss zero. Clubs are ranked by total points, then goal difference, then goals scored. If clubs are still level, head-to-head record decides. The champion lifts the trophy after Matchweek 18."/>
            </format-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
