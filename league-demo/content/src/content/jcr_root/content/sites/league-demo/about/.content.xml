<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="About"
            jcr:description="History, format, and governance of the Meridian Premier League."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">

            <!-- Page Header -->
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="About the League"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        kes:datasource="league-demo-about-hero"/>
            </page-header>

            <!-- History -->
            <history-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Our History"
                        headingType="h2"/>
                <history-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The Meridian Premier League was established in 2019, uniting ten of the region's most storied football clubs under a single competitive banner. What began as a proposal between club chairmen at the annual Meridian Football Association summit quickly became the most anticipated launch in regional football history."/>
                <history-text-2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The inaugural 2019-20 season drew record crowds as decades-old local rivalries were given a professional stage for the first time. Since then, the league has grown into a fully professional competition with dedicated broadcast coverage, youth development pathways, and a reputation for producing some of the most exciting football in the country."/>
                <history-text-3
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        kes:datasource="league-demo-current-season"
                        prefix="The "
                        suffix=" campaign continues a story of fierce competition: every champion since the league's founding has been a different club in the year that followed, and no team has ever successfully defended their title."/>
            </history-section>

            <!-- The Clubs -->
            <clubs-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="The Clubs"
                        headingType="h2"/>
                <clubs-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The MPL brings together ten clubs from across the Meridian region, ranging from Stone Valley -- the oldest club in the league, founded in 1886 -- to Southshore United, the youngest, established in 1947. Between them, these clubs represent over a thousand years of combined footballing tradition."/>
                <clubs-table
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/table"
                        variations="[/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-striped,/apps/kestros/commons/components/content/table/bootstrap-lib/1.0.0/variations/style/table-hover]"
                        kes:datasource="league-demo-about-clubs"/>
            </clubs-section>

            <!-- Competition Format -->
            <format-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Competition Format"
                        headingType="h2"/>
                <format-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        kes:datasource="league-demo-competition-format"/>
                <points-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Three points are awarded for a win, one for a draw, and none for a defeat. Clubs are ranked by total points. Where two or more clubs are level on points, the tiebreakers applied in order are: goal difference, goals scored, head-to-head record, and finally a playoff if required to determine the champion."/>
                <calendar-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The season typically runs from late August through early May, with matches held on Saturdays and selected midweek dates. Each matchweek features five simultaneous fixtures, ensuring every club is in action on the same day."/>
            </format-section>

            <!-- Season Awards -->
            <awards-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Season Awards"
                        headingType="h2"/>
                <awards-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="At the conclusion of each season, the league recognizes outstanding individual and team achievement with four major awards."/>
                <awards-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid"
                        layout="25-25-25-25"
                >
                    <column-1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <award-1-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Golden Boot"
                                headingType="h4"/>
                        <award-1-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Awarded to the season's leading goal scorer."/>
                    </column-1>
                    <column-2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <award-2-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Player of the Season"
                                headingType="h4"/>
                        <award-2-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Voted on by club managers and captains for the most outstanding individual contribution."/>
                    </column-2>
                    <column-3
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <award-3-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Manager of the Season"
                                headingType="h4"/>
                        <award-3-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Recognizes tactical excellence and leadership from the touchline."/>
                    </column-3>
                    <column-4
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="kestros/commons/components/content-area"
                    >
                        <award-4-heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/heading"
                                headingText="Young Player of the Season"
                                headingType="h4"/>
                        <award-4-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="/libs/kestros/commons/components/content/text"
                                text="Honours the standout performer aged 23 or under, voted on by a panel of league-accredited journalists."/>
                    </column-4>
                </awards-grid>
            </awards-section>

            <!-- Governance -->
            <governance-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Governance"
                        headingType="h2"/>
                <governance-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The Meridian Premier League is governed by the MPL Board, comprising one representative from each member club alongside an independent chairperson and two non-executive directors. The Board oversees competition rules, broadcast agreements, commercial partnerships, and the league's community investment programs."/>
                <governance-text-2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="The league operates under the jurisdiction of the Meridian Football Association (MFA) and adheres to the rules and regulations set by the national governing body. All clubs must meet annual licensing requirements covering financial stability, stadium standards, youth development, and community engagement."/>
            </governance-section>

        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
