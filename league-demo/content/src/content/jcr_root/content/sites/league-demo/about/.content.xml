<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:rep="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page"
>
    <jcr:content
            jcr:description="A fictional ten-club league used to demonstrate the Kestros sport-league sample site."
            jcr:mixinTypes="[mix:lockable]"
            jcr:primaryType="nt:unstructured"
            jcr:title="About"
            kes:template="/libs/kestros/commons/base-site-template"
            sling:resourceType="kestros/commons/components/kestros-base-page"
    >
        <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
        <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/content-area"
        >
            <hero
                    inlineVariations="uk-section uk-section-primary"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container uk-container-large"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <eyebrow
                            inlineVariations="uk-text-meta uk-text-uppercase"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="About the league"
                    />
                    <heading
                            headingText="Meridian Premier League."
                            headingType="h1"
                            inlineVariations="uk-heading-medium"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/heading"
                    />
                    <subtitle
                            inlineVariations="uk-text-lead"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/text"
                            text="A fictional ten-club league used as a Kestros demo site. Every number, name, and fixture on this site is made up - the structure is what matters."
                    />
                </container>
            </hero>
            <story
                    inlineVariations="uk-section uk-section-default"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
            >
                <container
                        inlineVariations="uk-container uk-container-large"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/container"
                >
                    <body
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/libs/kestros/commons/components/content/richtext"
                            text="&lt;div class=&quot;uk-width-2-3@m&quot;&gt;
        &lt;h2&gt;What this site is.&lt;/h2&gt;
        &lt;p&gt;This is a demonstration of a sport-league website built on Kestros. The templates are deliberately generic - the same HTL and CSS render basketball, hockey, cricket, or any other league-based sport. Only the datasources differ.&lt;/p&gt;
        &lt;h3&gt;What is hand-authored.&lt;/h3&gt;
        &lt;p&gt;On the current site, every team, match, and player is a literal JCR content node. You can see them in the JCR resolver at &lt;code&gt;/content/sites/league-demo&lt;/code&gt;.&lt;/p&gt;
        &lt;h3&gt;What datasources would feed.&lt;/h3&gt;
        &lt;p&gt;In a real deployment, every list on this site would be replaced with a single &lt;code&gt;content-area&lt;/code&gt; datasource:&lt;/p&gt;
        &lt;ul&gt;
          &lt;li&gt;&lt;strong&gt;Standings table&lt;/strong&gt; - &lt;code&gt;standings-for-season&lt;/code&gt; datasource. Rows and column labels come from the sport rule set.&lt;/li&gt;
          &lt;li&gt;&lt;strong&gt;Schedule&lt;/strong&gt; - &lt;code&gt;fixtures-for-season&lt;/code&gt; grouped by matchweek.&lt;/li&gt;
          &lt;li&gt;&lt;strong&gt;Teams index + team detail&lt;/strong&gt; - a single &lt;em&gt;kes:dynamic-page&lt;/em&gt; template with a &lt;code&gt;team-by-slug&lt;/code&gt; lookup, so every club renders from one template.&lt;/li&gt;
          &lt;li&gt;&lt;strong&gt;Player detail + match detail&lt;/strong&gt; - same dynamic-page pattern, with &lt;code&gt;player-by-slug&lt;/code&gt; and &lt;code&gt;match-by-id&lt;/code&gt; datasources.&lt;/li&gt;
          &lt;li&gt;&lt;strong&gt;Column labels&lt;/strong&gt; - &quot;Goals&quot;, &quot;Assists&quot;, &quot;Clean sheets&quot; - come from a &lt;code&gt;stat-schema&lt;/code&gt; the datasource exposes alongside the rows. Swap the schema, swap the sport.&lt;/li&gt;
        &lt;/ul&gt;
        &lt;h3&gt;What is next.&lt;/h3&gt;
        &lt;p&gt;Once the datasources are in place, this page will stay identical. The content nodes will just be replaced by a datasource reference and the dynamic page template will take over.&lt;/p&gt;
      &lt;/div&gt;"
                    />
                </container>
            </story>
        </main>
        <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="kestros/commons/components/inherited-content-area"
        />
    </jcr:content>
</jcr:root>
