<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="kes:Page">
    <jcr:content
            jcr:primaryType="nt:unstructured"
            jcr:title="Venues"
            jcr:description="A guide to the ten stadiums of the Meridian Premier League."
            sling:resourceType="kestros/commons/components/kestros-base-page">
        <header jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
        <main jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
            <page-header
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="hero">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Venues"
                        headingType="h1"/>
                <subtitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Ten stadiums across the Meridian region. From the 22,000-seat Meridian Stadium to the intimate Valley Ground."
                        variations="[/apps/kestros/commons/components/content/text/lfv2/0.0.1/variations/style/lead]"/>
            </page-header>

            <venues-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Stadium Guide"
                        headingType="h2"/>
                <venues-cards
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/lists/card-list"
                        kes:datasource="league-demo-venues"
                        layout="two-columns"
                        variations="[/apps/kestros/commons/components/lists/card-list/lfv2/0.0.1/variations/style/cards-shadow]"/>
            </venues-section>

            <info-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="/libs/kestros/commons/components/structure/section"
                    layout="dark">
                <heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/heading"
                        headingText="Visiting a Venue"
                        headingType="h2"/>
                <info-intro
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/content/text"
                        text="Whether it's your first match or your hundredth, every MPL ground welcomes new and returning supporters. The basics below apply across all ten clubs -- check the individual club's website for ground-specific details on hospitality, family sections, and away-end allocations."/>
                <info-grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/kestros/commons/components/structure/grid">
                    <column-1 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Getting There" headingType="h4"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="All MPL venues are accessible by public transport. Check your club's website for specific travel directions, parking information, and shuttle services on matchdays."/>
                    </column-1>
                    <column-2 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Accessibility" headingType="h4"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Every MPL stadium provides accessible seating, accessible toilets, and hearing assistance systems. Contact the venue directly to arrange assistance or to request a wheelchair space."/>
                    </column-2>
                    <column-3 jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/content-area">
                        <h jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/heading" headingText="Stadium Rules" headingType="h4"/>
                        <t jcr:primaryType="nt:unstructured" sling:resourceType="/libs/kestros/commons/components/content/text" text="Bags larger than A4 size are not permitted. No bottles, cans, or outside food and drink. Pyrotechnics, smoke devices, and laser pointers are strictly prohibited."/>
                    </column-3>
                </info-grid>
            </info-section>
        </main>
        <footer jcr:primaryType="nt:unstructured" sling:resourceType="kestros/commons/components/inherited-content-area"/>
    </jcr:content>
</jcr:root>
